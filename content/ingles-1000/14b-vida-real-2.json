            {
              "text": "Can I have some water?",
              "explanation": "¿me pone agua?"
            },
            {
              "text": "How much is it?",
              "explanation": "¿cuánto es?"
            },
            {
              "text": "The bill, please",
              "explanation": "la cuenta, por favor"
