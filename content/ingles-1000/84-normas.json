        {
          "key": "g-passive-modal",
          "type": "pattern",
          "goal": "Hay que hacerlo = it MUST BE DONE",
          "rule": "Pasiva con modal: modal + BE + participio. It must be done today. It can be recycled. Phones must be switched off.",
          "pieces": [
            {
              "text": "It",
              "role": "fixed",
              "hint": "eso"
            },
            {
              "text": "must be",
              "role": "fixed",
              "hint": "debe ser"
            },
            {
              "text": "done",
              "role": "slot",
              "hint": "hecho"
            }
          ],
          "examples": [
            {
              "text": "This form must be signed.",
              "translation": "Hay que firmar este impreso.",
              "mirror": {
                "say": "Hay que firmar este impreso",
                "pieces": [
                  {
                    "es": "debe ser",
                    "en": "must be",
                    "role": "helper",
                    "from": "Hay que",
                    "why": "«Hay que firmarlo» es «debe ser firmado»: must be signed."
                  },
                  {
                    "es": "firmado",
                    "en": "signed",
                    "role": "verb",
                    "from": "firmar"
                  },
                  {
                    "es": "Este impreso",
                    "en": "This form",
                    "role": "who",
                    "from": "este impreso"
                  }
                ],
                "order": [
                  2,
                  0,
                  1
                ]
              }
            },
            {
