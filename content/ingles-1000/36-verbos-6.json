      "key": "36-verbos-6",
      "title": "Misión 36 · Más verbos y el futuro",
      "units": [
        {
          "key": "g-will",
          "type": "pattern",
          "goal": "-RÉ = WILL: iré = I'LL GO",
          "rule": "Si en español acaba en -ré, -rás, -rá (iré, comerás), en inglés WILL delante del verbo tal cual: I'll go, you'll eat. Negativo: won't.",
          "pieces": [
            {
              "text": "I'll",
              "role": "fixed",
              "hint": "YO …-ré"
            },
            {
              "text": "call",
              "role": "slot",
              "hint": "llama-"
            }
          ],
          "examples": [
            {
              "text": "I'll call you tomorrow.",
              "translation": "Te llamaré mañana.",
              "mirror": {
                "say": "Te llamaré mañana",
                "pieces": [
                  {
                    "es": "te",
                    "en": "you",
                    "role": "word"
                  },
                  {
                    "es": "(YO) -RÉ",
                    "en": "I'll",
                    "role": "helper",
                    "from": "llamaré",
                    "why": "-RÉ al final es WILL delante: I'll call."
                  },
                  {
                    "es": "llama-",
                    "en": "call",
                    "role": "verb"
                  },
                  {
                    "es": "mañana",
                    "en": "tomorrow",
                    "role": "word"
                  }
                ],
                "order": [
                  1,
                  2,
                  0,
                  3
                ]
              }
            },
            {
              "text": "It will rain tomorrow.",
              "translation": "Mañana lloverá.",
              "mirror": {
                "say": "Mañana lloverá",
                "pieces": [
                  {
                    "es": "Mañana",
                    "en": "tomorrow",
                    "role": "word"
                  },
                  {
                    "es": "ESO",
                    "en": "It",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "llove-",
                    "en": "rain",
                    "role": "verb"
                  },
                  {
                    "es": "-RÁ",
                    "en": "will",
                    "role": "helper",
                    "from": "lloverá",
                    "why": "-RÁ = WILL: it will rain."
                  }
                ],
                "order": [
                  1,
                  3,
                  2,
                  0
                ]
              }
            },
            {
              "text": "Will you help me?",
              "translation": "¿Me ayudarás?"
            },
            {
              "text": "I won't tell anyone.",
              "translation": "No se lo diré a nadie."
            }
          ],
          "pitfalls": [
            "«I will to go» está mal: detrás de will, el verbo tal cual.",
            "Para planes ya decididos se usa más going to; WILL, para decidir en el momento o predecir."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "Cada -RÉ del futuro lleva un WILL de mochila.",
            "emoji": "🔮"
          },
          "tense": "Will (futuro)",
          "timeline": [
            {
              "kind": "event",
              "at": 1.6,
              "label": "pasará"
            }
          ],
          "signals": [
            "I think",
            "probably",
            "tomorrow",
            "I promise",
            "OK, I…"
          ],
          "drills": [
            {
              "text": "The phone is ringing. — OK, I ___ (get) it!",
              "answer": "will get",
              "wrong": [
                "get",
                "got"
              ],
              "signal": "OK",
              "es": "Está sonando el teléfono. — ¡Vale, ya lo cojo yo!"
            },
            {
              "text": "I think it ___ (be) sunny tomorrow.",
              "answer": "will be",
              "wrong": [
                "is",
                "was"
              ],
              "signal": "I think",
              "es": "Creo que mañana hará sol."
            },
            {
              "text": "I promise I ___ (not / tell) anyone.",
              "answer": "won't tell",
              "wrong": [
                "don't tell",
                "didn't tell"
              ],
              "signal": "I promise",
              "es": "Te prometo que no se lo diré a nadie."
            }
          ]
        },
