        {
          "key": "g-in-on-at",
          "type": "pattern",
          "goal": "IN, ON, AT: ¿cuándo?",
          "rule": "AT para la hora (at five), ON para el día (on Monday), IN para lo largo: meses, años y estaciones (in May, in 2025, in summer).",
          "pieces": [
            {
              "text": "at",
              "role": "fixed",
              "hint": "a las"
            },
            {
              "text": "five",
              "role": "slot",
              "hint": "cinco"
            }
          ],
          "examples": [
            {
              "text": "The class is at five.",
              "translation": "La clase es a las cinco.",
              "mirror": {
                "say": "La clase es a las cinco",
