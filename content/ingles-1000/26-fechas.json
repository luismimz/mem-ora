                  {
                    "es": "La clase",
                    "en": "The class",
                    "role": "who"
                  },
                  {
                    "es": "es",
                    "en": "is",
                    "role": "helper"
                  },
                  {
                    "es": "a las cinco",
                    "en": "at five",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "I was born in May.",
