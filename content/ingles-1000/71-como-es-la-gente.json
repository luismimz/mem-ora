      "key": "71-como-es-la-gente",
      "title": "Misión 71 · Cómo es la gente (B1)",
      "units": [
        {
          "key": "g-relative",
          "type": "pattern",
          "goal": "El chico QUE vive aquí = the boy WHO lives here",
          "rule": "QUE es WHO para personas, WHICH para cosas y THAT para las dos; donde es WHERE. The man who called. The book that I read.",
          "pieces": [
            {
              "text": "the boy",
              "role": "slot",
              "hint": "el chico"
            },
            {
              "text": "who",
              "role": "fixed",
              "hint": "que"
            },
            {
              "text": "lives here",
              "role": "fixed",
              "hint": "vive aquí"
            }
          ],
          "examples": [
            {
              "text": "The girl who lives next door is a nurse.",
              "translation": "La chica que vive al lado es enfermera.",
              "mirror": {
                "say": "La chica que vive al lado es enfermera",
                "pieces": [
                  {
                    "es": "La chica",
                    "en": "The girl",
                    "role": "who"
                  },
                  {
                    "es": "quien",
                    "en": "who",
                    "role": "word",
                    "from": "que",
                    "why": "QUE de persona es WHO."
                  },
                  {
                    "es": "vive al lado",
                    "en": "lives next door",
                    "role": "verb"
                  },
                  {
                    "es": "es",
                    "en": "is",
                    "role": "helper"
                  },
                  {
                    "es": "una enfermera",
                    "en": "a nurse",
                    "role": "word",
                    "from": "enfermera",
                    "why": "Tu trabajo siempre lleva A: a nurse."
                  }
                ]
              }
            },
            {
              "text": "This is the app that I use.",
              "translation": "Esta es la app que uso.",
              "mirror": {
                "say": "Esta es la app que uso",
                "pieces": [
                  {
                    "es": "Esta es",
                    "en": "This is",
                    "role": "helper"
                  },
                  {
                    "es": "la app",
                    "en": "the app",
                    "role": "word"
                  },
                  {
                    "es": "que",
                    "en": "that",
                    "role": "word",
                    "from": "que",
                    "why": "QUE de cosa es THAT (o WHICH)."
                  },
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "uso",
                    "en": "use",
                    "role": "verb"
                  }
                ]
              }
            },
            {
              "text": "The town where I was born.",
              "translation": "El pueblo donde nací."
            },
            {
              "text": "The book which you lent me.",
              "translation": "El libro que me prestaste."
            }
          ],
          "pitfalls": [
            "«The man which called» está mal: las personas van con WHO.",
            "En «the app that I use» el THAT se puede quitar: the app I use."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "WHO lleva CARA; WHICH, un TORNILLO; THAT vale para todo.",
            "emoji": "🔗"
          }
        },
