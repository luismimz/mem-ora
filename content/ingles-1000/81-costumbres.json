      "units": [
        {
          "key": "g-be-used-to",
          "type": "pattern",
          "goal": "Estoy acostumbrado = I'M USED TO + -ING",
          "rule": "Estar acostumbrado: be used to + -ING o nombre (I'm used to the cold). Acostumbrarse: get used to. Ojo: I used to = antes solía.",
          "pieces": [
            {
              "text": "I'm used to",
              "role": "fixed",
              "hint": "estoy acostumbrado a"
            },
            {
              "text": "getting up early",
              "role": "slot",
              "hint": "madrugar"
            }
          ],
          "examples": [
            {
              "text": "I'm used to getting up early.",
              "translation": "Estoy acostumbrado a madrugar.",
              "mirror": {
                "say": "Estoy acostumbrado a madrugar",
                "pieces": [
                  {
                    "es": "(YO) estoy",
                    "en": "I'm",
                    "role": "helper",
                    "from": "Estoy"
                  },
                  {
                    "es": "acostumbrado a",
                    "en": "used to",
                    "role": "word"
                  },
                  {
                    "es": "levantándome temprano",
                    "en": "getting up early",
                    "role": "verb",
                    "from": "madrugar",
                    "why": "Aquí TO es preposición: to + -ING."
                  }
                ]
              }
            },
            {
              "text": "You'll get used to it.",
              "translation": "Ya te acostumbrarás.",
              "mirror": {
                "say": "Ya te acostumbrarás",
                "pieces": [
                  {
                    "es": "(TÚ) -RÁS",
                    "en": "You'll",
                    "role": "helper",
                    "from": "acostumbrarás"
                  },
                  {
                    "es": "acostumbrarte",
                    "en": "get used",
                    "role": "verb",
                    "from": "te acostumbrarás",
                    "why": "Acostumbrarse es GET used to."
                  },
                  {
                    "es": "A ESO",
                    "en": "to it",
                    "role": "word",
                    "ghost": true
                  }
                ]
              }
            },
            {
              "text": "I'm not used to the cold.",
              "translation": "No estoy acostumbrado al frío."
            },
            {
              "text": "She is getting used to her new job.",
              "translation": "Se está acostumbrando a su nuevo trabajo."
