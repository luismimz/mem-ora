      "title": "Misión 78 · Tareas de casa (B1)",
      "units": [
        {
          "key": "g-few-little",
          "type": "pattern",
          "goal": "Pocos y poco: A FEW o A LITTLE",
          "rule": "Con lo que se cuenta: A FEW (a few friends). Con lo que no: A LITTLE (a little time). Sin la A suena negativo: few friends = casi ninguno.",
          "pieces": [
            {
              "text": "I have",
              "role": "fixed",
              "hint": "tengo"
            },
            {
              "text": "a few",
              "role": "fixed",
              "hint": "unos pocos"
            },
            {
              "text": "friends",
              "role": "slot",
              "hint": "amigos"
            }
          ],
          "examples": [
            {
              "text": "I have a few friends here.",
              "translation": "Tengo unos cuantos amigos aquí.",
              "mirror": {
                "say": "Tengo unos cuantos amigos aquí",
                "pieces": [
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "tengo",
                    "en": "have",
                    "role": "verb"
                  },
                  {
                    "es": "unos pocos",
                    "en": "a few",
                    "role": "word",
                    "from": "unos cuantos",
                    "why": "Los amigos se cuentan: A FEW."
                  },
                  {
                    "es": "amigos",
                    "en": "friends",
                    "role": "word"
                  },
                  {
                    "es": "aquí",
                    "en": "here",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "Add a little salt.",
              "translation": "Añade un poco de sal.",
              "mirror": {
                "say": "Añade un poco de sal",
                "pieces": [
                  {
                    "es": "Añade",
                    "en": "Add",
                    "role": "verb"
                  },
                  {
                    "es": "un poco de",
                    "en": "a little",
                    "role": "word",
                    "from": "un poco de",
                    "why": "La sal no se cuenta: A LITTLE."
                  },
                  {
                    "es": "sal",
                    "en": "salt",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "Just a few minutes.",
              "translation": "Solo unos minutos."
            },
            {
              "text": "I speak a little English.",
              "translation": "Hablo un poco de inglés."
            }
          ],
          "pitfalls": [
            "«A few salt» está mal: la sal no se cuenta (a little salt).",
            "«Few people came» es casi nadie; «a few people came», unos cuantos."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "A FEW cuenta CANICAS; A LITTLE echa una GOTA.",
            "emoji": "🧂"
          }
        },
