      "units": [
        {
          "key": "g-directions",
          "type": "pattern",
          "goal": "Indicar el camino",
          "rule": "Go straight on (todo recto), turn left / right (gira), take the second street (coge la segunda calle). It's on the left (a la izquierda).",
          "pieces": [
            {
              "text": "Turn",
              "role": "fixed",
              "hint": "gira a"
            },
            {
              "text": "left",
              "role": "slot",
              "hint": "la izquierda"
            }
          ],
          "examples": [
            {
              "text": "Go straight on and turn right.",
              "translation": "Sigue todo recto y gira a la derecha.",
              "mirror": {
                "say": "Sigue todo recto y gira a la derecha",
                "pieces": [
                  {
                    "es": "Sigue",
                    "en": "Go",
                    "role": "verb"
                  },
                  {
                    "es": "todo recto",
                    "en": "straight on",
                    "role": "word"
                  },
                  {
                    "es": "y",
                    "en": "and",
                    "role": "word"
                  },
                  {
                    "es": "gira",
                    "en": "turn",
                    "role": "verb"
                  },
                  {
                    "es": "a la derecha",
                    "en": "right",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "It's on the left.",
              "translation": "Está a la izquierda.",
              "mirror": {
                "say": "Está a la izquierda",
                "pieces": [
                  {
                    "es": "(ESO) está",
                    "en": "It's",
                    "role": "helper"
                  },
                  {
                    "es": "en la izquierda",
                    "en": "on the left",
                    "role": "word",
                    "from": "a la izquierda",
                    "why": "Estar a un lado es ON the left."
                  }
                ]
              }
            },
            {
              "text": "Take the second street on the right.",
              "translation": "Coge la segunda calle a la derecha."
            },
            {
              "text": "Excuse me, how do I get to the station?",
              "translation": "Perdone, ¿cómo llego a la estación?"
            }
          ],
          "pitfalls": [
            "«Turn to the left» se entiende, pero se dice turn left.",
            "Todo recto no es «all straight»: go straight on."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "Un GPS con ACENTO inglés: TURN LEFT, GO STRAIGHT ON.",
            "emoji": "🧭"
          }
        },
