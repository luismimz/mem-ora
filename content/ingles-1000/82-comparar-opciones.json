      "key": "82-comparar-opciones",
      "title": "Misión 82 · Elegir entre opciones (B1)",
      "units": [
        {
          "key": "g-both-either",
          "type": "pattern",
          "goal": "Los dos o ninguno: BOTH, EITHER, NEITHER",
          "rule": "BOTH = los dos (both are good). EITHER = cualquiera de los dos (either is fine). NEITHER = ninguno de los dos (neither is cheap).",
          "pieces": [
            {
              "text": "Both",
              "role": "fixed",
              "hint": "los dos"
            },
            {
              "text": "options",
              "role": "slot",
              "hint": "opciones"
            },
            {
              "text": "are good",
              "role": "fixed",
              "hint": "son buenas"
            }
          ],
          "examples": [
            {
              "text": "Both options are good.",
              "translation": "Las dos opciones son buenas.",
              "mirror": {
                "say": "Las dos opciones son buenas",
                "pieces": [
                  {
                    "es": "Ambas opciones",
                    "en": "Both options",
                    "role": "who",
                    "from": "Las dos opciones"
                  },
                  {
                    "es": "son",
                    "en": "are",
                    "role": "helper"
                  },
                  {
                    "es": "buenas",
                    "en": "good",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "Neither of them is cheap.",
              "translation": "Ninguno de los dos es barato.",
              "mirror": {
                "say": "Ninguno de los dos es barato",
                "pieces": [
                  {
                    "es": "Ninguno de ellos",
                    "en": "Neither of them",
                    "role": "who",
                    "from": "Ninguno de los dos"
                  },
                  {
                    "es": "es",
                    "en": "is",
                    "role": "helper",
                    "from": "es",
                    "why": "Neither va con verbo en singular: neither IS."
                  },
                  {
                    "es": "barato",
                    "en": "cheap",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "Either day is fine for me.",
              "translation": "Cualquiera de los dos días me viene bien."
            },
            {
              "text": "I like both.",
              "translation": "Me gustan los dos."
            }
          ],
          "practice": [
            {
              "text": "Both are doctors.",
              "translation": "Los dos son médicos.",
              "mirror": {
                "say": "Los dos son médicos",
                "pieces": [
                  {
                    "es": "Ambos",
                    "en": "Both",
                    "role": "who"
                  },
                  {
                    "es": "son",
                    "en": "are",
                    "role": "helper"
                  },
                  {
                    "es": "médicos",
                    "en": "doctors",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "Neither of them came.",
              "translation": "Ninguno de los dos vino.",
              "mirror": {
                "say": "Ninguno de los dos vino",
                "pieces": [
                  {
                    "es": "Ninguno de ellos",
                    "en": "Neither of them",
                    "role": "who"
                  },
                  {
                    "es": "vino",
                    "en": "came",
                    "role": "verb"
                  }
                ]
              }
            },
            {
              "text": "Either is fine.",
              "translation": "Cualquiera de los dos vale.",
              "mirror": {
                "say": "Cualquiera de los dos vale",
                "pieces": [
                  {
                    "es": "Cualquiera",
                    "en": "Either",
                    "role": "who"
                  },
                  {
                    "es": "es",
                    "en": "is",
                    "role": "helper"
                  },
                  {
                    "es": "bien",
                    "en": "fine",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "I like both colours.",
              "translation": "Me gustan los dos colores.",
              "mirror": {
                "say": "Me gustan los dos colores",
                "pieces": [
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "gusto",
                    "en": "like",
                    "role": "verb"
                  },
                  {
                    "es": "ambos colores",
                    "en": "both colours",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "Both rooms are big.",
              "translation": "Ambas habitaciones son grandes.",
              "mirror": {
                "say": "Ambas habitaciones son grandes",
                "pieces": [
                  {
                    "es": "Ambas habitaciones",
                    "en": "Both rooms",
                    "role": "who"
                  },
                  {
                    "es": "son",
                    "en": "are",
                    "role": "helper"
                  },
                  {
                    "es": "grandes",
                    "en": "big",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "Neither option is good.",
              "translation": "Ninguna opción es buena.",
              "mirror": {
                "say": "Ninguna opción es buena",
                "pieces": [
                  {
                    "es": "Ninguna opción",
                    "en": "Neither option",
                    "role": "who"
                  },
                  {
                    "es": "es",
                    "en": "is",
                    "role": "helper"
                  },
                  {
                    "es": "buena",
                    "en": "good",
                    "role": "word"
                  }
                ]
              }
            }
          ],
          "pitfalls": [
            "«Both of them is» está mal: both va en plural (are).",
            "«Neither is not» está mal: una sola negación (neither is)."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "BOTH abraza a DOS; NEITHER no abraza a NINGUNO.",
            "emoji": "✌️"
          }
