      "units": [
        {
          "key": "g-connectors",
          "type": "pattern",
          "goal": "Aunque / A pesar de: ALTHOUGH, DESPITE, HOWEVER",
          "rule": "ALTHOUGH + frase (although it rained). DESPITE + nombre o -ING (despite the rain). HOWEVER abre una frase nueva: However, we went.",
          "pieces": [
            {
              "text": "Although",
              "role": "fixed",
              "hint": "aunque"
            },
            {
              "text": "it was raining",
              "role": "slot",
              "hint": "llovía"
            }
          ],
          "examples": [
            {
              "text": "Although it was raining, we went out.",
              "translation": "Aunque llovía, salimos.",
              "mirror": {
                "say": "Aunque llovía, salimos",
                "pieces": [
                  {
                    "es": "Aunque",
                    "en": "Although",
                    "role": "word"
                  },
                  {
                    "es": "ESO estaba lloviendo",
                    "en": "it was raining",
                    "role": "verb",
                    "from": "llovía"
                  },
                  {
                    "es": "NOSOTROS",
                    "en": "We",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "salimos",
                    "en": "went out",
                    "role": "verb"
                  }
                ]
              }
            },
            {
              "text": "Despite the rain, we went out.",
              "translation": "A pesar de la lluvia, salimos.",
              "mirror": {
                "say": "A pesar de la lluvia, salimos",
                "pieces": [
                  {
                    "es": "A pesar de",
                    "en": "Despite",
                    "role": "word",
                    "from": "A pesar de",
                    "why": "DESPITE va sin «of»: despite the rain."
                  },
                  {
                    "es": "la lluvia",
                    "en": "the rain",
                    "role": "word"
                  },
                  {
                    "es": "NOSOTROS",
                    "en": "We",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "salimos",
                    "en": "went out",
                    "role": "verb"
                  }
                ]
              }
            },
            {
              "text": "It was expensive. However, it was worth it.",
              "translation": "Era caro. Sin embargo, mereció la pena."
            },
            {
              "text": "Even though I was tired, I finished.",
              "translation": "Aunque estaba cansado, terminé."
            }
          ],
          "pitfalls": [
            "«Despite of» está mal: despite (o in spite of).",
            "«Despite it was raining» está mal: con frase, although."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "ALTHOUGH lleva FRASE; DESPITE, solo una COSA.",
            "emoji": "🧩"
          }
        },
