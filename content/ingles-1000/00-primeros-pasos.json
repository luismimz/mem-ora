            {
              "text": "Are",
              "role": "fixed",
              "hint": "¿Estás → salta"
            },
            {
              "text": "you",
              "role": "fixed",
              "hint": "TÚ"
            },
            {
              "text": "hungry",
              "role": "slot",
              "hint": "hambriento"
            }
          ],
          "examples": [
