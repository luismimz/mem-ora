  "modules": [
    {
      "key": "00-primeros-pasos",
      "title": "Misión 0 · Primeros pasos: cómo se construye una frase",
      "units": [
        {
          "key": "g-yo-fantasma",
          "type": "pattern",
          "goal": "El YO fantasma: en inglés siempre se dice quién",
          "rule": "El español esconde el quién (soy, tengo, quiero). El inglés SIEMPRE lo dice: I am, I have, I want.",
          "pieces": [
            {
              "text": "I",
              "role": "fixed",
              "hint": "YO 👻"
            },
            {
              "text": "am",
              "role": "fixed",
              "hint": "soy"
            },
            {
              "text": "Luis",
              "role": "slot",
              "hint": "Luis"
            }
          ],
          "examples": [
            {
              "text": "I am Luis.",
              "translation": "Soy Luis.",
              "mirror": {
                "say": "Soy Luis",
                "pieces": [
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "soy",
                    "en": "am",
                    "role": "helper"
                  },
                  {
                    "es": "Luis",
                    "en": "Luis",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "I have a dog.",
              "translation": "Tengo un perro.",
              "mirror": {
                "say": "Tengo un perro",
                "pieces": [
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "tengo",
                    "en": "have",
                    "role": "verb"
                  },
                  {
                    "es": "un perro",
                    "en": "a dog",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "We want water.",
              "translation": "Queremos agua.",
              "mirror": {
                "say": "Queremos agua",
                "pieces": [
                  {
                    "es": "NOSOTROS",
                    "en": "We",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "queremos",
                    "en": "want",
                    "role": "verb"
                  },
                  {
                    "es": "agua",
                    "en": "water",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "She is tired.",
              "translation": "Está cansada.",
              "mirror": {
                "say": "Está cansada",
                "pieces": [
                  {
                    "es": "ELLA",
                    "en": "She",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "está",
                    "en": "is",
                    "role": "helper"
                  },
                  {
                    "es": "cansada",
                    "en": "tired",
                    "role": "word"
                  }
                ]
              }
            }
          ],
          "pitfalls": [
            "«Am Luis» o «Have a dog» están mal: sin el quién no hay frase."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "Un FANTASMA YO vive dentro de cada verbo español.",
            "emoji": "👻"
          }
        },
        {
          "key": "g-tengo-estoy",
          "type": "pattern",
          "goal": "Hambre, frío, sueño: en inglés se ESTÁ",
          "rule": "Lo que sientes no se tiene: se ESTÁ. Tengo hambre → YO estoy hambriento → I am hungry.",
          "pieces": [
            {
              "text": "I",
              "role": "fixed",
              "hint": "YO"
            },
            {
              "text": "am",
              "role": "fixed",
              "hint": "tengo → estoy"
            },
            {
              "text": "hungry",
              "role": "slot",
              "hint": "hambriento"
            }
          ],
          "examples": [
            {
              "text": "I am hungry.",
              "translation": "Tengo hambre.",
              "mirror": {
                "say": "Tengo hambre",
                "pieces": [
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "estoy",
                    "en": "am",
                    "role": "helper",
                    "from": "tengo",
                    "why": "Se siente, no se toca: estar (TO BE)."
                  },
                  {
                    "es": "hambriento",
                    "en": "hungry",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "I am cold.",
              "translation": "Tengo frío.",
              "mirror": {
                "say": "Tengo frío",
                "pieces": [
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "estoy",
                    "en": "am",
                    "role": "helper",
                    "from": "tengo",
                    "why": "Se siente, no se toca: estar (TO BE)."
                  },
                  {
                    "es": "helado",
                    "en": "cold",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "She is thirsty.",
              "translation": "Tiene sed.",
              "mirror": {
                "say": "Tiene sed",
                "pieces": [
                  {
                    "es": "ELLA",
                    "en": "She",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "está",
                    "en": "is",
                    "role": "helper",
                    "from": "tiene",
                    "why": "Se siente, no se toca: estar (TO BE)."
                  },
                  {
                    "es": "sedienta",
                    "en": "thirsty",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "We are sleepy.",
              "translation": "Tenemos sueño.",
              "mirror": {
                "say": "Tenemos sueño",
                "pieces": [
                  {
                    "es": "NOSOTROS",
                    "en": "We",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "estamos",
                    "en": "are",
                    "role": "helper",
                    "from": "tenemos",
                    "why": "Se siente, no se toca: estar (TO BE)."
                  },
                  {
                    "es": "con sueño",
                    "en": "sleepy",
                    "role": "word"
                  }
                ]
              }
            }
          ],
          "pitfalls": [
            "«I have hungry» es el error más típico: el hambre se siente, no se tiene."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "Tu TRIPA no TIENE hambre: ESTÁ hambrienta.",
            "emoji": "🍔"
          }
        },
        {
          "key": "g-question-jump",
          "type": "pattern",
          "goal": "Preguntar: el ayudante SALTA delante",
          "rule": "Para preguntar, el ayudante (am, are, is, can) salta delante del quién: you are → ARE YOU hungry?",
