                  2
                ]
              }
            },
            {
              "text": "Are we late?",
              "translation": "¿Llegamos tarde?",
              "mirror": {
                "say": "¿Llegamos tarde?",
                "pieces": [
                  {
                    "es": "NOSOTROS",
