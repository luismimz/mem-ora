                "pieces": [
                  {
                    "es": "ELLA",
                    "en": "she",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "está",
                    "en": "is",
                    "role": "helper"
                  },
                  {
                    "es": "cansada",
                    "en": "tired",
                    "role": "word"
