              "mirror": {
                "say": "Está corriendo ahora",
                "pieces": [
                  {
                    "es": "ELLA",
                    "en": "She",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "está",
                    "en": "is",
                    "role": "helper"
                  },
                  {
                    "es": "corr-IENDO",
                    "en": "runn-ING",
                    "role": "verb"
                  },
                  {
                    "es": "ahora",
                    "en": "now",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "We are waiting for the bus.",
              "translation": "Estamos esperando el autobús."
            },
            {
              "text": "They are swimming.",
              "translation": "Están nadando."
            }
          ],
          "pitfalls": [
            "«Am walking» está mal: falta el YO (I).",
            "Para lo de siempre, sin -ing: I walk to work every day."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "Cada -ANDO cambia de disfraz y sale como -ING.",
            "emoji": "🎭"
          }
        },
        {
          "key": "chunks-verbos",
          "type": "concept",
          "name": "Piezas de Lego: listen to, wait for, think about, depend on",
          "gist": "Verbos que van siempre con su pieza pegada",
          "definition": "Muchos verbos llevan su pieza pegada y no funcionan sin ella: listen TO (escuchar), wait FOR (esperar), think ABOUT (pensar en), depend ON (depender de). Apréndelos como un solo bloque: si cambias la pieza, rebotan.",
          "examples": [
            {
              "text": "Listen to the music.",
              "explanation": "Escucha la música: listen TO."
            },
            {
              "text": "Wait for me!",
              "explanation": "¡Espérame!: wait FOR."
            },
            {
              "text": "I think about you.",
              "explanation": "Pienso en ti: think ABOUT."
            },
            {
              "text": "It depends on you.",
              "explanation": "Depende de ti: depend ON."
            }
          ],
          "contrast": "La pieza no es la del español: «pensar EN» es think ABOUT, no «think in»; «depender DE» es depend ON.",
          "exercises": [
            {
              "kind": "apply_case",
              "prompt": "Escucha la música → Listen ___ the music",
              "answer": "TO",
              "distractors": [
                "FOR",
                "ABOUT",
                "ON"
              ]
            },
            {
              "kind": "apply_case",
              "prompt": "Espérame → Wait ___ me",
              "answer": "FOR",
              "distractors": [
                "TO",
                "ABOUT",
                "ON"
              ]
            },
            {
              "kind": "apply_case",
              "prompt": "Pienso en ti → I think ___ you",
              "answer": "ABOUT",
              "distractors": [
                "TO",
                "FOR",
                "ON"
              ]
            },
            {
              "kind": "apply_case",
              "prompt": "Depende de ti → It depends ___ you",
