        {
          "key": "g-present-continuous",
          "type": "pattern",
          "goal": "Decir lo que estás haciendo AHORA",
          "rule": "am / is / are + verbo con -ing. El -ANDO / -IENDO español pasa a -ING: estoy camin-ANDO → I am walk-ING.",
          "pieces": [
            {
              "text": "I",
              "role": "fixed",
              "hint": "YO"
            },
            {
              "text": "am",
              "role": "fixed",
              "hint": "estoy"
            },
            {
              "text": "walking",
              "role": "slot",
              "hint": "camin-ANDO → walk-ING"
            }
          ],
          "examples": [
            {
              "text": "I am walking to work.",
              "translation": "Estoy caminando al trabajo.",
              "mirror": {
                "say": "Estoy caminando al trabajo",
                "pieces": [
