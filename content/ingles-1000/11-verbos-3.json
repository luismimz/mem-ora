                  {
                    "es": "estoy",
                    "en": "am",
                    "role": "helper"
                  },
                  {
                    "es": "camin-ANDO",
                    "en": "walk-ING",
                    "role": "verb"
                  },
                  {
                    "es": "al trabajo",
                    "en": "to work",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "She is running now.",
