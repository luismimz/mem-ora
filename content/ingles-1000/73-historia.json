  "modules": [
    {
      "key": "73-historia",
      "title": "Misión 73 · Historia (B1)",
      "units": [
        {
          "key": "g-passive-past",
          "type": "pattern",
          "goal": "Se construyó = it WAS BUILT",
          "rule": "La pasiva en pasado: was/were + participio. It was built in 1889. Si dices quién lo hizo: by. It was painted by Picasso.",
          "pieces": [
            {
              "text": "It",
              "role": "fixed",
              "hint": "eso"
            },
            {
              "text": "was",
              "role": "fixed",
              "hint": "fue"
            },
            {
              "text": "built",
              "role": "slot",
              "hint": "construido"
            }
          ],
          "examples": [
            {
              "text": "The tower was built in 1889.",
              "translation": "La torre se construyó en 1889.",
              "mirror": {
                "say": "La torre se construyó en 1889",
                "pieces": [
                  {
                    "es": "La torre",
                    "en": "The tower",
                    "role": "who"
                  },
                  {
                    "es": "fue",
                    "en": "was",
                    "role": "helper",
                    "from": "se",
                    "why": "«Se construyó» es pasiva: was built."
                  },
                  {
                    "es": "construida",
                    "en": "built",
                    "role": "verb",
                    "from": "construyó"
                  },
                  {
                    "es": "en 1889",
                    "en": "in 1889",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "These houses were destroyed in the war.",
              "translation": "Estas casas fueron destruidas en la guerra.",
              "mirror": {
                "say": "Estas casas fueron destruidas en la guerra",
                "pieces": [
                  {
                    "es": "Estas casas",
                    "en": "These houses",
                    "role": "who"
                  },
                  {
                    "es": "fueron",
                    "en": "were",
                    "role": "helper"
                  },
                  {
                    "es": "destruidas",
                    "en": "destroyed",
                    "role": "verb"
                  },
                  {
                    "es": "en la guerra",
                    "en": "in the war",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "It was painted by Picasso.",
              "translation": "Lo pintó Picasso."
            },
            {
              "text": "When was it invented?",
              "translation": "¿Cuándo se inventó?"
            }
          ],
          "pitfalls": [
            "«It was build» está mal: el participio, built.",
            "En plural: WERE (they were built)."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "Un SELLO antiguo con FECHA: WAS + participio.",
            "emoji": "🏛️"
          }
        },
        {
          "key": "invent",
          "type": "term",
          "text": "invent",
          "meaning": "inventar",
          "pronunciation": "inVÉNT",
          "examples": [
            {
              "text": "Who invented the telephone?",
              "translation": "¿Quién inventó el teléfono?",
              "mirror": {
                "say": "¿Quién inventó el teléfono?",
                "pieces": [
                  {
                    "es": "Quién",
                    "en": "Who",
                    "role": "who"
                  },
                  {
                    "es": "inventó",
                    "en": "invented",
                    "role": "verb"
                  },
                  {
                    "es": "el teléfono",
                    "en": "the telephone",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "A great invention.",
              "translation": "Un gran invento."
            }
          ]
        },
        {
          "key": "century",
          "type": "term",
          "text": "century",
          "meaning": "siglo",
          "pronunciation": "SÉNchuri",
          "examples": [
            {
              "text": "In the 21st century.",
              "translation": "En el siglo XXI.",
              "mirror": {
                "say": "En el siglo XXI",
                "pieces": [
                  {
                    "es": "En el",
                    "en": "In the",
                    "role": "word"
                  },
                  {
                    "es": "siglo",
                    "en": "century",
                    "role": "word"
                  },
                  {
                    "es": "21.º",
                    "en": "21st",
                    "role": "word",
                    "from": "XXI",
                    "why": "Los siglos van con número ordinal y DELANTE: the 21st century."
                  }
                ],
                "order": [
                  0,
                  2,
                  1
                ]
              }
            },
            {
              "text": "A century ago.",
              "translation": "Hace un siglo."
            }
          ]
        },
