      "key": "65-dinero",
      "title": "Misión 65 · Dinero",
      "units": [
        {
          "key": "g-how-much",
          "type": "pattern",
          "goal": "¿Cuánto cuesta? = HOW MUCH IS it?",
          "rule": "Para el precio: How much is it? (o How much does it cost?). En plural: How much are they? Respuesta: It's 10 euros.",
          "pieces": [
            {
              "text": "How much",
              "role": "fixed",
              "hint": "¿cuánto"
            },
            {
              "text": "is",
              "role": "fixed",
              "hint": "cuesta"
            },
            {
              "text": "this jacket",
              "role": "slot",
              "hint": "esta chaqueta"
            }
          ],
          "examples": [
            {
              "text": "How much is this jacket?",
              "translation": "¿Cuánto cuesta esta chaqueta?",
              "mirror": {
                "say": "¿Cuánto cuesta esta chaqueta?",
                "pieces": [
                  {
                    "es": "Cuánto",
                    "en": "How much",
                    "role": "word"
                  },
                  {
                    "es": "es",
                    "en": "is",
                    "role": "helper",
                    "from": "cuesta",
                    "why": "Para el precio basta con IS: how much is it?"
                  },
                  {
                    "es": "esta chaqueta",
                    "en": "this jacket",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "How much are the tickets?",
              "translation": "¿Cuánto valen las entradas?",
              "mirror": {
                "say": "¿Cuánto valen las entradas?",
                "pieces": [
                  {
                    "es": "Cuánto",
                    "en": "How much",
                    "role": "word"
                  },
                  {
                    "es": "son",
                    "en": "are",
                    "role": "helper",
                    "from": "valen",
                    "why": "En plural: how much ARE they?"
                  },
                  {
                    "es": "las entradas",
                    "en": "the tickets",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "It's ten euros.",
              "translation": "Son diez euros."
            },
            {
              "text": "How much does it cost?",
              "translation": "¿Cuánto cuesta?"
            }
          ],
          "pitfalls": [
            "«How many is it?» está mal: el dinero se mide, how MUCH.",
            "El precio va con IT IS: it's ten euros."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "Una HUCHA pregunta: HOW MUCH? y escupe MONEDAS.",
            "emoji": "🐷"
          }
        },
