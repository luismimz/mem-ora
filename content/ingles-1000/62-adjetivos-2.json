              "hint": "es"
            },
            {
              "text": "so",
              "role": "fixed",
              "hint": "tan"
            },
            {
              "text": "beautiful",
              "role": "slot",
              "hint": "bonito"
            }
          ],
          "examples": [
            {
              "text": "It's so cold!",
              "translation": "¡Qué frío hace!",
              "mirror": {
                "say": "¡Qué frío hace!",
