                  {
                    "es": "tan",
                    "en": "so",
                    "role": "word",
                    "from": "Qué"
                  },
                  {
                    "es": "frío",
                    "en": "cold",
                    "role": "word"
                  },
                  {
                    "es": "(ESO) es",
                    "en": "It's",
                    "role": "helper",
                    "from": "hace",
                    "why": "El tiempo va con IT IS: it's cold."
                  }
                ],
                "order": [
                  2,
                  0,
                  1
                ]
              }
            },
            {
