      "units": [
        {
          "key": "g-make-do",
          "type": "pattern",
          "goal": "Hacer: MAKE o DO",
          "rule": "MAKE para crear o producir (make a cake, make a mistake, make a decision). DO para tareas y actividades (do homework, do sport).",
          "pieces": [
            {
              "text": "make",
              "role": "fixed",
              "hint": "hacer (crear)"
            },
            {
              "text": "a mistake",
              "role": "slot",
              "hint": "un error"
            }
          ],
          "examples": [
            {
              "text": "I made a mistake.",
              "translation": "Cometí un error.",
              "mirror": {
                "say": "Cometí un error",
                "pieces": [
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "hice",
                    "en": "made",
                    "role": "verb",
                    "from": "Cometí",
                    "why": "Un error se HACE con make: make a mistake."
                  },
                  {
                    "es": "un error",
                    "en": "a mistake",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "Have you done your homework?",
              "translation": "¿Has hecho los deberes?",
              "mirror": {
                "say": "¿Has hecho los deberes?",
                "pieces": [
                  {
                    "es": "Has",
                    "en": "Have",
                    "role": "helper"
                  },
                  {
                    "es": "TÚ",
                    "en": "you",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "hecho",
                    "en": "done",
                    "role": "verb",
                    "from": "hecho",
                    "why": "Las tareas van con DO: do homework."
                  },
                  {
                    "es": "TUS deberes",
                    "en": "your homework",
                    "role": "word",
                    "from": "los deberes"
                  }
                ]
              }
            },
            {
              "text": "It doesn't make sense.",
              "translation": "No tiene sentido."
            },
            {
              "text": "Do me a favour.",
              "translation": "Hazme un favor."
            }
          ],
          "pitfalls": [
            "«Do a mistake» está mal: make a mistake.",
            "«Make homework» está mal: do homework."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "MAKE tiene HORNO y crea; DO tiene LISTA de tareas.",
            "emoji": "🛠️"
          }
        },
