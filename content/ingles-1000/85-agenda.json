      "units": [
        {
          "key": "g-future-continuous",
          "type": "pattern",
          "goal": "Estaré trabajando = I'LL BE working",
          "rule": "Para lo que estará en marcha en un momento futuro: will be + -ING. This time tomorrow I'll be flying. Will you be using the car?",
          "pieces": [
            {
              "text": "I'll be",
              "role": "fixed",
              "hint": "estaré"
            },
            {
              "text": "working",
              "role": "slot",
              "hint": "trabajando"
            }
          ],
          "examples": [
            {
              "text": "This time tomorrow I'll be flying to London.",
              "translation": "Mañana a esta hora estaré volando a Londres.",
              "mirror": {
                "say": "Mañana a esta hora estaré volando a Londres",
                "pieces": [
                  {
                    "es": "mañana a esta hora",
                    "en": "This time tomorrow",
                    "role": "word",
                    "from": "Mañana a esta hora"
                  },
                  {
                    "es": "(YO) -RÉ estar",
                    "en": "I'll be",
                    "role": "helper",
                    "from": "estaré",
                    "why": "Lo que estará en marcha: will be + -ING."
                  },
                  {
                    "es": "volando",
                    "en": "flying",
                    "role": "verb"
                  },
                  {
                    "es": "a Londres",
                    "en": "to London",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "Don't call at nine, I'll be working.",
              "translation": "No llames a las nueve, estaré trabajando.",
              "mirror": {
                "say": "No llames a las nueve, estaré trabajando",
                "pieces": [
                  {
                    "es": "No",
                    "en": "Don't",
                    "role": "helper"
                  },
                  {
                    "es": "llames",
                    "en": "call",
                    "role": "verb"
                  },
                  {
                    "es": "a las nueve",
                    "en": "at nine",
                    "role": "word"
                  },
                  {
                    "es": "(YO) -RÉ estar",
                    "en": "I'll be",
                    "role": "helper",
                    "from": "estaré",
                    "why": "Lo que estará en marcha: will be + -ING."
                  },
                  {
                    "es": "trabajando",
                    "en": "working",
                    "role": "verb"
                  }
                ]
              }
            },
            {
              "text": "Will you be using the car tonight?",
              "translation": "¿Vas a usar el coche esta noche?"
            },
            {
              "text": "We'll be waiting for you.",
              "translation": "Te estaremos esperando."
            }
          ],
          "pitfalls": [
            "«I'll working» está mal: falta BE (I'll be working).",
            "Es para un momento concreto del futuro; si no, basta con will."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "Una FOTO del FUTURO en plena acción: WILL BE -ING.",
            "emoji": "🔮"
          },
          "tense": "Futuro continuo",
          "timeline": [
            {
              "kind": "action",
              "at": 1.0,
              "to": 2.2,
              "label": "en marcha"
            },
            {
              "kind": "ref",
              "at": 1.6,
              "label": "mañana a esta hora"
            }
          ],
          "signals": [
            "this time tomorrow",
            "at nine tomorrow",
            "all day tomorrow"
          ],
          "drills": [
            {
              "text": "This time tomorrow I ___ (fly) to London.",
              "answer": "will be flying",
              "wrong": [
                "will fly",
                "flew"
              ],
              "signal": "This time tomorrow",
              "es": "Mañana a esta hora estaré volando a Londres."
            },
            {
              "text": "Don't call at nine; I ___ (work).",
              "answer": "will be working",
              "wrong": [
                "will work",
                "worked"
              ],
              "signal": "at nine",
              "es": "No llames a las nueve; estaré trabajando."
            },
            {
              "text": "At midnight we ___ (sleep).",
              "answer": "will be sleeping",
              "wrong": [
                "will sleep",
                "slept"
              ],
              "signal": "At midnight",
              "es": "A medianoche estaremos durmiendo."
            }
          ]
        },
