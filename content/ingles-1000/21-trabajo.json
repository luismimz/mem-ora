      "key": "21-trabajo",
      "title": "Misión 21 · En el trabajo",
      "units": [
        {
          "key": "g-comparatives",
          "type": "pattern",
          "goal": "Comparar: más grande que = BIGGER THAN",
          "rule": "Palabra corta: + -ER THAN (bigger than). Larga: MORE … THAN (more expensive than). Ojo: better, worse.",
          "pieces": [
            {
              "text": "Madrid",
              "role": "fixed",
              "hint": "Madrid"
            },
            {
              "text": "is",
              "role": "fixed",
              "hint": "es"
            },
            {
              "text": "bigger",
              "role": "slot",
              "hint": "más grande"
            },
            {
              "text": "than",
              "role": "fixed",
              "hint": "que"
            },
            {
              "text": "Toledo",
              "role": "fixed",
              "hint": "Toledo"
            }
          ],
          "examples": [
            {
              "text": "Madrid is bigger than Toledo.",
              "translation": "Madrid es más grande que Toledo.",
              "mirror": {
                "say": "Madrid es más grande que Toledo",
                "pieces": [
                  {
                    "es": "Madrid",
                    "en": "Madrid",
                    "role": "who"
                  },
                  {
                    "es": "es",
                    "en": "is",
                    "role": "helper"
                  },
                  {
                    "es": "grande-ER",
                    "en": "big-GER",
                    "role": "word",
                    "from": "más grande",
                    "why": "Palabra corta: -ER al final. Big → bigger."
                  },
                  {
                    "es": "que",
                    "en": "than",
                    "role": "word"
                  },
                  {
                    "es": "Toledo",
                    "en": "Toledo",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "This phone is more expensive than that one.",
              "translation": "Este móvil es más caro que ese.",
              "mirror": {
                "say": "Este móvil es más caro que ese",
                "pieces": [
                  {
                    "es": "Este móvil",
                    "en": "This phone",
                    "role": "who"
                  },
                  {
                    "es": "es",
                    "en": "is",
                    "role": "helper"
                  },
                  {
                    "es": "más caro",
                    "en": "more expensive",
                    "role": "word"
                  },
                  {
                    "es": "que",
                    "en": "than",
                    "role": "word"
                  },
                  {
                    "es": "ese",
                    "en": "that one",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "My new job is better than my old job.",
              "translation": "Mi trabajo nuevo es mejor que el anterior."
            },
            {
              "text": "Today is worse than yesterday.",
              "translation": "Hoy es peor que ayer."
            }
          ],
          "pitfalls": [
            "«More big» está mal: palabra corta → bigger.",
            "Mejor y peor no siguen la regla: better, worse."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "Las palabras CORTAS crecen con -ER; las LARGAS piden MORE.",
            "emoji": "📏"
          }
        },
