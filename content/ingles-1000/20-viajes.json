      "key": "20-viajes",
      "title": "Misión 20 · De viaje",
      "units": [
        {
          "key": "g-going-to",
          "type": "pattern",
          "goal": "Contar tus planes: voy a = I'M GOING TO",
          "rule": "«Voy a + verbo» casi igual en inglés: I'm going to + verbo. Para planes ya decididos: I'm going to travel.",
          "pieces": [
            {
              "text": "I'm",
              "role": "fixed",
              "hint": "YO estoy"
            },
            {
              "text": "going to",
              "role": "fixed",
              "hint": "voy a"
            },
            {
              "text": "travel",
              "role": "slot",
              "hint": "viajar"
            }
          ],
          "examples": [
            {
              "text": "I'm going to travel to Italy.",
              "translation": "Voy a viajar a Italia.",
              "mirror": {
                "say": "Voy a viajar a Italia",
                "pieces": [
                  {
                    "es": "(YO) estoy",
                    "en": "I'm",
                    "role": "helper",
                    "from": "voy",
                    "why": "«Voy a» se dice «estoy yendo a»: I'm going to."
                  },
                  {
                    "es": "yendo a",
                    "en": "going to",
                    "role": "verb"
                  },
                  {
                    "es": "viajar",
                    "en": "travel",
                    "role": "verb"
                  },
                  {
                    "es": "a Italia",
                    "en": "to Italy",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "Are you going to come?",
              "translation": "¿Vas a venir?",
              "mirror": {
                "say": "¿Vas a venir?",
                "pieces": [
                  {
                    "es": "TÚ",
                    "en": "you",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "estás",
                    "en": "Are",
                    "role": "helper",
                    "from": "vas",
                    "why": "Para preguntar, el ayudante salta: ARE you going to…?"
                  },
                  {
                    "es": "yendo a",
                    "en": "going to",
                    "role": "verb"
                  },
                  {
                    "es": "venir",
                    "en": "come",
                    "role": "verb"
                  }
                ],
                "order": [
                  1,
                  0,
                  2,
                  3
                ]
              }
            },
            {
              "text": "It's going to rain.",
              "translation": "Va a llover."
            },
            {
              "text": "We're going to buy a car.",
              "translation": "Vamos a comprar un coche."
            }
          ],
          "pitfalls": [
            "«I going to…» está mal: falta el ayudante (I'M going to).",
            "Detrás de going to, el verbo tal cual: going to eat."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "Un TREN llamado GOING TO te lleva a tus planes.",
            "emoji": "🚆"
          }
        },
