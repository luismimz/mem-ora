      "units": [
        {
          "key": "g-good-at",
          "type": "pattern",
          "goal": "Se me da bien = I'M GOOD AT + -ING",
          "rule": "Para lo que se te da bien: I'm good at + -ING o nombre (good at drawing, good at chess). Lo contrario: I'm bad at.",
          "pieces": [
            {
              "text": "I'm good",
              "role": "fixed",
              "hint": "se me da bien"
            },
            {
              "text": "at",
              "role": "fixed",
              "hint": "(en)"
            },
            {
              "text": "drawing",
              "role": "slot",
              "hint": "dibujar"
            }
          ],
          "examples": [
            {
              "text": "I'm good at drawing.",
              "translation": "Se me da bien dibujar.",
              "mirror": {
                "say": "Se me da bien dibujar",
                "pieces": [
                  {
                    "es": "(YO) soy bueno",
                    "en": "I'm good",
                    "role": "helper",
                    "from": "Se me da bien",
                    "why": "«Se me da bien» es «soy bueno en»: I'm good at."
                  },
                  {
                    "es": "EN",
                    "en": "at",
                    "role": "word",
                    "ghost": true
                  },
                  {
                    "es": "dibuj-ANDO",
                    "en": "drawing",
                    "role": "verb",
                    "from": "dibujar",
                    "why": "Detrás de at, el verbo en -ING: drawing."
                  }
                ]
              }
            },
            {
              "text": "He's bad at chess.",
              "translation": "Se le da mal el ajedrez.",
              "mirror": {
                "say": "Se le da mal el ajedrez",
                "pieces": [
                  {
                    "es": "(ÉL) es malo",
                    "en": "He's bad",
                    "role": "helper",
                    "from": "Se le da mal"
                  },
                  {
                    "es": "EN",
                    "en": "at",
                    "role": "word",
                    "ghost": true
                  },
                  {
                    "es": "ajedrez",
                    "en": "chess",
                    "role": "word",
                    "from": "el ajedrez",
                    "why": "Los juegos van sin «the»."
                  }
                ]
              }
            },
            {
              "text": "Are you good at sports?",
              "translation": "¿Se te dan bien los deportes?"
            },
            {
              "text": "I'm not very good at singing.",
              "translation": "No canto muy bien."
            }
          ],
          "pitfalls": [
            "«I'm good in drawing» está mal: good AT.",
            "«Good at draw» está mal: good at drawing."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "Un DIPLOMA dorado dice: GOOD AT DRAWING.",
            "emoji": "🏅"
          }
        },
