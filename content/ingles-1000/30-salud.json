        {
          "key": "g-should",
          "type": "pattern",
          "goal": "Dar consejos: deberías = YOU SHOULD",
          "rule": "Deberías + verbo = you should + verbo tal cual: you should rest. No deberías = you shouldn't.",
          "pieces": [
            {
              "text": "You",
              "role": "fixed",
              "hint": "TÚ"
            },
            {
              "text": "should",
              "role": "fixed",
              "hint": "deberías"
            },
            {
              "text": "rest",
              "role": "slot",
              "hint": "descansar"
            }
          ],
          "examples": [
            {
              "text": "You should see a doctor.",
              "translation": "Deberías ir al médico.",
              "mirror": {
                "say": "Deberías ir al médico",
                "pieces": [
                  {
                    "es": "TÚ",
                    "en": "You",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "deberías",
                    "en": "should",
                    "role": "helper"
                  },
                  {
                    "es": "ver",
                    "en": "see",
                    "role": "verb",
                    "from": "ir",
                    "why": "Ir al médico es VER a un médico: see a doctor."
                  },
                  {
                    "es": "a un médico",
                    "en": "a doctor",
                    "role": "word",
                    "from": "al médico"
                  }
                ]
              }
            },
            {
              "text": "You shouldn't smoke.",
              "translation": "No deberías fumar.",
