      "key": "74-medio-ambiente",
      "title": "Misión 74 · El planeta (B1)",
      "units": [
        {
          "key": "g-so-neither",
          "type": "pattern",
          "goal": "Yo también / Yo tampoco = SO DO I / NEITHER DO I",
          "rule": "«Yo también»: SO + ayudante + I (so do I, so am I). «Yo tampoco»: NEITHER + ayudante + I (neither do I). El ayudante copia la frase.",
          "pieces": [
            {
              "text": "So",
              "role": "fixed",
              "hint": "también"
            },
            {
              "text": "do",
              "role": "fixed",
              "hint": "(ayudante)"
            },
            {
              "text": "I",
              "role": "slot",
              "hint": "yo"
            }
          ],
          "examples": [
            {
              "text": "I love the sea. So do I.",
              "translation": "Me encanta el mar. A mí también.",
              "mirror": {
                "say": "Me encanta el mar. A mí también",
                "pieces": [
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "encanto",
                    "en": "love",
                    "role": "verb",
                    "from": "Me encanta",
                    "why": "Encantar se da la vuelta: I love…"
                  },
                  {
                    "es": "el mar",
                    "en": "the sea",
                    "role": "word"
                  },
                  {
                    "es": "yo",
                    "en": "I",
                    "role": "who",
                    "from": "A mí",
                    "why": "«A mí también» es «también lo hago yo»: so do I."
                  },
                  {
                    "es": "Así",
                    "en": "So",
                    "role": "word",
                    "from": "también"
                  },
                  {
                    "es": "",
                    "en": "do",
                    "role": "signal"
                  }
                ],
                "order": [
                  0,
                  1,
                  2,
                  4,
                  5,
                  3
                ]
              }
            },
            {
              "text": "I'm not tired. Neither am I.",
              "translation": "No estoy cansado. Yo tampoco.",
              "mirror": {
                "say": "No estoy cansado. Yo tampoco",
                "pieces": [
                  {
                    "es": "(YO) no estoy",
                    "en": "I'm not",
                    "role": "helper",
                    "from": "No estoy"
                  },
                  {
                    "es": "cansado",
                    "en": "tired",
                    "role": "word"
                  },
                  {
                    "es": "yo",
                    "en": "I",
                    "role": "who",
                    "from": "Yo"
                  },
                  {
                    "es": "Tampoco",
                    "en": "Neither",
                    "role": "word",
                    "from": "tampoco",
                    "why": "Tras NEITHER, el ayudante en positivo: neither AM I."
                  },
                  {
                    "es": "",
                    "en": "am",
                    "role": "signal"
                  }
                ],
                "order": [
                  0,
                  1,
                  3,
                  4,
                  2
                ]
              }
            },
            {
              "text": "She can swim. So can I.",
              "translation": "Ella sabe nadar. Yo también."
            },
            {
              "text": "I didn't go. Neither did I.",
              "translation": "Yo no fui. Yo tampoco."
            }
          ],
          "pitfalls": [
            "«Me too» y «me neither» valen al hablar; so do I es lo correcto.",
            "Tras NEITHER, el ayudante va en positivo: neither do I (no «neither don't I»)."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "Un ESPEJO: SO y NEITHER copian el AYUDANTE.",
            "emoji": "👯"
          }
        },
