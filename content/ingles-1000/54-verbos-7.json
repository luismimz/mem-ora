      "units": [
        {
          "key": "g-ago",
          "type": "pattern",
          "goal": "Hace dos años = two years AGO",
          "rule": "Para decir cuánto hace: tiempo + AGO, al final y con el verbo en pasado. I met her two years ago.",
          "pieces": [
            {
              "text": "two years",
              "role": "slot",
              "hint": "dos años"
            },
            {
              "text": "ago",
              "role": "fixed",
              "hint": "hace"
            }
          ],
          "examples": [
            {
              "text": "I started two months ago.",
              "translation": "Empecé hace dos meses.",
              "mirror": {
                "say": "Empecé hace dos meses",
                "pieces": [
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "empecé",
                    "en": "started",
                    "role": "verb"
                  },
                  {
                    "es": "hace",
                    "en": "ago",
                    "role": "word"
                  },
                  {
                    "es": "dos meses",
                    "en": "two months",
                    "role": "word"
                  }
                ],
                "order": [
                  0,
                  1,
                  3,
                  2
                ]
              }
            },
            {
              "text": "She called five minutes ago.",
              "translation": "Llamó hace cinco minutos.",
              "mirror": {
                "say": "Llamó hace cinco minutos",
                "pieces": [
                  {
                    "es": "ELLA",
                    "en": "She",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "llamó",
                    "en": "called",
                    "role": "verb"
                  },
                  {
                    "es": "hace",
                    "en": "ago",
                    "role": "word"
                  },
                  {
                    "es": "cinco minutos",
                    "en": "five minutes",
                    "role": "word"
                  }
                ],
                "order": [
                  0,
                  1,
                  3,
                  2
                ]
              }
            },
            {
              "text": "A long time ago.",
              "translation": "Hace mucho tiempo."
            },
            {
              "text": "How long ago?",
              "translation": "¿Hace cuánto?"
            }
          ],
          "pitfalls": [
            "«Ago two years» está mal: AGO va al final.",
            "«Hace dos años que vivo aquí» no es ago: I have lived here for two years."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "AGO llega TARDE y se sienta al FINAL.",
            "emoji": "⏳"
          }
        },
        {
          "key": "decide",
          "type": "term",
          "text": "decide",
