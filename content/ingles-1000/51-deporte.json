      "key": "51-deporte",
      "title": "Misión 51 · Deporte",
      "units": [
        {
          "key": "g-play-go-do",
          "type": "pattern",
          "goal": "Jugar, ir, hacer: PLAY, GO o DO",
          "rule": "PLAY con pelota (play tennis), GO con actividades en -ING (go swimming) y DO con lo demás (do yoga, do karate).",
          "pieces": [
            {
              "text": "I",
              "role": "fixed",
              "hint": "yo"
            },
            {
              "text": "go",
              "role": "fixed",
              "hint": "voy a"
            },
            {
              "text": "swimming",
              "role": "slot",
              "hint": "nadar"
            }
          ],
          "examples": [
            {
              "text": "I play basketball on Fridays.",
              "translation": "Juego al baloncesto los viernes.",
              "mirror": {
                "say": "Juego al baloncesto los viernes",
                "pieces": [
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "juego",
                    "en": "play",
                    "role": "verb"
                  },
                  {
                    "es": "baloncesto",
                    "en": "basketball",
                    "role": "word",
                    "from": "al baloncesto",
                    "why": "Los deportes van sin «al» ni «the»: play basketball."
                  },
                  {
                    "es": "EN viernes",
                    "en": "on Fridays",
                    "role": "word",
                    "from": "los viernes",
                    "why": "Los días llevan ON: on Monday, on Fridays."
                  }
                ]
              }
            },
            {
              "text": "We go running every morning.",
              "translation": "Salimos a correr cada mañana.",
              "mirror": {
                "say": "Salimos a correr cada mañana",
                "pieces": [
                  {
                    "es": "NOSOTROS",
                    "en": "We",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "vamos",
                    "en": "go",
                    "role": "verb",
                    "from": "Salimos"
                  },
                  {
                    "es": "corriendo",
                    "en": "running",
                    "role": "word",
                    "from": "a correr",
                    "why": "Con GO, la actividad en -ING: go swimming."
                  },
                  {
                    "es": "cada mañana",
                    "en": "every morning",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "She does yoga.",
              "translation": "Hace yoga."
            },
            {
              "text": "Let's play a match!",
              "translation": "¡Juguemos un partido!"
            }
          ],
          "pitfalls": [
            "«Play swimming» está mal: go swimming.",
            "«Play the football» sobra the: play football."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "Con PELOTA, PLAY; con -ING, GO; lo demás, DO.",
            "emoji": "⚽"
          }
        },
