  "modules": [
    {
      "key": "83-tecnologia-2",
      "title": "Misión 83 · El móvil y la red (B1)",
      "units": [
        {
          "key": "g-as-as",
          "type": "pattern",
          "goal": "Tan rápido como = AS fast AS",
          "rule": "Para decir que dos cosas son iguales: AS + adjetivo + AS (as tall as me). En negativo: NOT AS… AS (not as expensive as).",
          "pieces": [
            {
              "text": "as",
              "role": "fixed",
              "hint": "tan"
            },
            {
              "text": "fast",
              "role": "slot",
              "hint": "rápido"
            },
            {
              "text": "as",
              "role": "fixed",
              "hint": "como"
            }
          ],
          "examples": [
            {
              "text": "My phone is as fast as yours.",
              "translation": "Mi móvil es tan rápido como el tuyo.",
              "mirror": {
                "say": "Mi móvil es tan rápido como el tuyo",
                "pieces": [
                  {
                    "es": "Mi móvil",
                    "en": "My phone",
                    "role": "who"
                  },
                  {
                    "es": "es",
                    "en": "is",
                    "role": "helper"
                  },
                  {
                    "es": "tan rápido como",
                    "en": "as fast as",
                    "role": "word",
                    "from": "tan rápido como",
                    "why": "Igualdad: AS + adjetivo + AS."
                  },
                  {
                    "es": "el tuyo",
                    "en": "yours",
                    "role": "word",
                    "from": "el tuyo",
                    "why": "El tuyo es una sola palabra: yours."
                  }
                ]
              }
            },
            {
              "text": "It isn't as expensive as I thought.",
              "translation": "No es tan caro como pensaba.",
              "mirror": {
                "say": "No es tan caro como pensaba",
                "pieces": [
                  {
                    "es": "(ESO) no es",
                    "en": "It isn't",
                    "role": "helper",
                    "from": "No es"
                  },
                  {
                    "es": "tan caro como",
                    "en": "as expensive as",
                    "role": "word"
                  },
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "pensé",
                    "en": "thought",
                    "role": "verb",
                    "from": "pensaba"
                  }
                ]
              }
            },
            {
              "text": "Come as soon as possible.",
              "translation": "Ven lo antes posible."
            },
            {
              "text": "She's as tall as me.",
              "translation": "Es tan alta como yo."
            },
            {
              "text": "The cat is as big as the dog.",
              "translation": "El gato es tan grande como el perro.",
              "stage": [
                {
                  "e": "🐱",
                  "x": 30,
                  "y": 60,
                  "s": 1.7
                },
                {
                  "e": "🐶",
                  "x": 72,
                  "y": 60,
                  "s": 1.7
                }
              ]
            },
            {
              "text": "The cat isn't as big as the dog.",
              "translation": "El gato no es tan grande como el perro.",
              "stage": [
                {
                  "e": "🐱",
                  "x": 30,
                  "y": 68,
                  "s": 1
                },
                {
                  "e": "🐶",
                  "x": 68,
                  "y": 56,
                  "s": 2.3
                }
              ]
            },
            {
              "text": "The dog isn't as big as the cat.",
              "translation": "El perro no es tan grande como el gato.",
              "stage": [
                {
                  "e": "🐱",
                  "x": 32,
                  "y": 56,
                  "s": 2.3
                },
                {
                  "e": "🐶",
                  "x": 72,
                  "y": 68,
                  "s": 1
                }
              ]
            },
            {
              "text": "The tree is as tall as the house.",
              "translation": "El árbol es tan alto como la casa.",
              "stage": [
                {
                  "e": "🌳",
                  "x": 30,
                  "y": 55,
                  "s": 2.2
                },
                {
                  "e": "🏠",
                  "x": 72,
                  "y": 55,
                  "s": 2.2
                }
              ]
            }
          ],
          "pitfalls": [
            "«As fast than» está mal: AS… AS.",
            "Para «lo antes posible»: as soon as possible (ASAP)."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "Dos AS sujetan el adjetivo como un SÁNDWICH.",
            "emoji": "🥪"
          }
        },
