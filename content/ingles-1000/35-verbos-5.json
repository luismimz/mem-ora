      "key": "35-verbos-5",
      "title": "Misión 35 · Verbos para hablar de todo",
      "units": [
        {
          "key": "g-object-pronouns",
          "type": "pattern",
          "goal": "Lo, la, le: DETRÁS del verbo",
          "rule": "En español «lo, la, le» van delante (la veo); en inglés, detrás: I see HER, call HIM, love IT. Son me, you, him, her, it, us, them.",
          "pieces": [
            {
              "text": "I see",
              "role": "fixed",
              "hint": "veo"
            },
            {
              "text": "her",
              "role": "slot",
              "hint": "la"
            }
          ],
          "examples": [
            {
              "text": "I see her every day.",
              "translation": "La veo todos los días.",
              "mirror": {
                "say": "La veo todos los días",
                "pieces": [
                  {
                    "es": "la",
                    "en": "her",
                    "role": "word"
                  },
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "veo",
                    "en": "see",
                    "role": "verb"
                  },
                  {
                    "es": "cada día",
                    "en": "every day",
                    "role": "word",
                    "from": "todos los días",
                    "why": "«Todos los días» es CADA día: every day."
                  }
                ],
                "order": [
                  1,
                  2,
                  0,
                  3
                ]
              }
            },
            {
              "text": "Call him tomorrow.",
              "translation": "Llámalo mañana.",
              "mirror": {
                "say": "Llámalo mañana",
                "pieces": [
                  {
                    "es": "Llama",
                    "en": "Call",
                    "role": "verb",
                    "from": "Llámalo",
                    "why": "Lo pegado se separa y va detrás: call HIM."
                  },
                  {
                    "es": "lo",
                    "en": "him",
                    "role": "word"
                  },
                  {
                    "es": "mañana",
                    "en": "tomorrow",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "I love them.",
              "translation": "Los quiero."
            },
            {
              "text": "Can you help us?",
              "translation": "¿Nos puedes ayudar?"
            }
          ],
          "pitfalls": [
            "«I her see» está mal: el pronombre va DETRÁS del verbo.",
            "Le / les se traducen según la persona: him, her o them."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "En inglés, LO, LA y LE caminan DETRÁS del verbo.",
            "emoji": "🚶"
          }
        },
