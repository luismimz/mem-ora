      "key": "57-clase-oficina",
      "title": "Misión 57 · En clase y en la oficina",
      "units": [
        {
          "key": "g-it-takes",
          "type": "pattern",
          "goal": "Tardo 20 minutos = IT TAKES ME 20 minutes",
          "rule": "Para el tiempo que cuesta algo: it takes (me) + tiempo. It takes me 20 minutes to get to school. How long does it take?",
          "pieces": [
            {
              "text": "It takes me",
              "role": "fixed",
              "hint": "tardo"
            },
            {
              "text": "20 minutes",
              "role": "slot",
              "hint": "20 minutos"
            }
          ],
          "examples": [
            {
              "text": "It takes me twenty minutes to get to school.",
              "translation": "Tardo veinte minutos en llegar a clase.",
              "mirror": {
                "say": "Tardo veinte minutos en llegar a clase",
                "pieces": [
                  {
                    "es": "ESO me lleva",
                    "en": "It takes me",
                    "role": "helper",
                    "from": "Tardo",
                    "why": "Tardar es «a mí me lleva»: it takes me."
                  },
                  {
                    "es": "veinte minutos",
                    "en": "twenty minutes",
                    "role": "word"
                  },
                  {
                    "es": "para llegar",
                    "en": "to get",
                    "role": "verb",
                    "from": "en llegar"
                  },
                  {
                    "es": "a la escuela",
                    "en": "to school",
                    "role": "word",
                    "from": "a clase"
                  }
                ]
              }
            },
            {
              "text": "How long does it take?",
              "translation": "¿Cuánto se tarda?",
              "mirror": {
                "say": "¿Cuánto se tarda?",
                "pieces": [
                  {
                    "es": "Cuánto tiempo",
                    "en": "How long",
                    "role": "word",
                    "from": "Cuánto"
                  },
                  {
                    "es": "",
                    "en": "does",
                    "role": "signal"
                  },
                  {
                    "es": "ESO",
                    "en": "it",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "lleva",
                    "en": "take",
                    "role": "verb",
                    "from": "se tarda"
                  }
                ]
              }
            },
            {
              "text": "It takes two hours by train.",
              "translation": "En tren son dos horas."
            },
            {
              "text": "It won't take long.",
              "translation": "No tardaré mucho."
            }
          ],
          "pitfalls": [
            "«I take twenty minutes» suena raro: it takes me twenty minutes.",
            "Para preguntar: how long does it take?"
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "El RELOJ te COBRA minutos: IT TAKES ME…",
            "emoji": "⏱️"
          }
        },
        {
          "key": "g-zero-conditional",
          "type": "pattern",
          "goal": "Si pasa A, siempre pasa B: IF you heat ice, it MELTS",
          "rule": "Para lo que pasa siempre (reglas, ciencia, costumbres): IF + presente, presente. If you press here, it starts.",
          "pieces": [
            {
              "text": "If you heat ice,",
              "role": "fixed",
              "hint": "si calientas el hielo"
            },
            {
              "text": "it melts",
              "role": "slot",
              "hint": "se derrite (siempre)"
            }
          ],
          "examples": [
            {
              "text": "If you heat ice, it melts.",
              "translation": "Si calientas el hielo, se derrite.",
              "mirror": {
                "say": "Si calientas el hielo, se derrite",
                "pieces": [
                  {
                    "es": "si",
                    "en": "If",
                    "role": "word"
                  },
                  {
                    "es": "TÚ",
                    "en": "you",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "calientas",
                    "en": "heat",
                    "role": "verb"
                  },
                  {
                    "es": "el hielo",
                    "en": "ice",
                    "role": "word"
                  },
                  {
                    "es": "ÉL",
                    "en": "it",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "se derrite",
                    "en": "melts",
                    "role": "verb"
                  }
                ]
              }
            },
            {
              "text": "If you press this button, the printer starts.",
              "translation": "Si pulsas este botón, la impresora arranca."
            },
            {
              "text": "If I drink coffee at night, I don't sleep.",
              "translation": "Si tomo café por la noche, no duermo."
            },
            {
              "text": "Plants die if they don't get water.",
              "translation": "Las plantas mueren si no reciben agua."
            }
          ],
          "pitfalls": [
            "Aquí no hay will: para lo que pasa siempre, presente en las dos partes.",
            "If se puede cambiar por when: When you heat ice, it melts."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "Pulsas el INTERRUPTOR y la luz SIEMPRE se enciende.",
            "emoji": "💡"
          },
          "tense": "Condicional cero",
          "timeline": [
            {
              "kind": "habit",
              "at": -3,
              "to": 3,
              "label": "siempre: si A, B"
            }
          ],
          "signals": [
            "If you…",
            "When you…",
            "always",
            "every time"
          ],
          "drills": [
            {
              "text": "If you heat ice, it ___ (melt).",
              "answer": "melts",
              "wrong": [
                "melted",
                "would melt"
              ],
              "signal": "If you heat ice",
              "es": "Si calientas el hielo, se derrite."
            },
            {
              "text": "If I drink coffee at night, I ___ (not / sleep).",
              "answer": "don't sleep",
              "wrong": [
                "didn't sleep",
                "wouldn't sleep"
              ],
              "signal": "If I drink coffee",
              "es": "Si tomo café por la noche, no duermo."
            },
            {
              "text": "Plants ___ (die) if they don't get water.",
              "answer": "die",
              "wrong": [
                "died",
                "would die"
              ],
              "signal": "if they don't get water",
              "es": "Las plantas mueren si no reciben agua."
            }
          ]
        },
