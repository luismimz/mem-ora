      "units": [
        {
          "key": "g-wear",
          "type": "pattern",
          "goal": "Llevar ropa puesta = WEAR",
          "rule": "La ropa que llevas puesta es WEAR (no carry): I'm wearing a coat. Ponerse = PUT ON; probarse = TRY ON.",
          "pieces": [
            {
              "text": "I'm",
              "role": "fixed",
              "hint": "YO estoy"
            },
            {
              "text": "wearing",
              "role": "fixed",
              "hint": "llevando puesto"
            },
            {
              "text": "a coat",
              "role": "slot",
              "hint": "un abrigo"
            }
          ],
          "examples": [
            {
              "text": "She's wearing a red dress.",
              "translation": "Lleva un vestido rojo.",
              "mirror": {
                "say": "Lleva un vestido rojo",
                "pieces": [
                  {
                    "es": "(ELLA) está",
                    "en": "She's",
                    "role": "helper",
                    "from": "lleva",
                    "why": "Lo que llevas puesto ahora: está LLEVANDO. She's wearing."
                  },
                  {
                    "es": "llevando",
                    "en": "wearing",
                    "role": "verb"
                  },
                  {
                    "es": "un",
                    "en": "a",
                    "role": "word"
                  },
                  {
                    "es": "vestido",
                    "en": "dress",
                    "role": "word"
                  },
                  {
                    "es": "rojo",
                    "en": "red",
                    "role": "word"
                  }
                ],
                "order": [
                  0,
                  1,
                  2,
                  4,
                  3
                ]
              }
            },
            {
              "text": "I don't wear a tie.",
              "translation": "No llevo corbata.",
              "mirror": {
                "say": "No llevo corbata",
                "pieces": [
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "no",
                    "en": "don't",
                    "role": "helper"
                  },
                  {
                    "es": "llevo",
                    "en": "wear",
                    "role": "verb"
                  },
                  {
                    "es": "una corbata",
                    "en": "a tie",
                    "role": "word",
                    "from": "corbata"
                  }
                ]
              }
            },
            {
              "text": "Can I try it on?",
              "translation": "¿Me lo puedo probar?"
            },
            {
              "text": "Put on your shoes.",
              "translation": "Ponte los zapatos."
            }
          ],
          "pitfalls": [
            "«Carry a coat» es llevarlo en la mano; puesto es WEAR.",
            "Probarse ropa: TRY ON (try it on)."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "El ARMARIO grita WEAR cada vez que te vistes.",
            "emoji": "👕"
          }
