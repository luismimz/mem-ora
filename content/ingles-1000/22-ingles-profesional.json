    {
      "key": "22-ingles-profesional",
      "title": "Misión 22 · Inglés profesional (correos y CV)",
      "units": [
        {
          "key": "g-passive",
          "type": "pattern",
          "goal": "La pasiva: «se hace» = IS DONE",
          "rule": "«Se prueba», «se escribió»: el «se» se convierte en IS o WAS y el verbo va en participio. The app is tested. It was written in Java.",
          "pieces": [
            {
              "text": "The app",
              "role": "fixed",
              "hint": "La aplicación"
            },
            {
              "text": "is",
              "role": "fixed",
              "hint": "se → es"
            },
            {
              "text": "tested",
              "role": "slot",
              "hint": "probada"
            }
          ],
          "examples": [
            {
              "text": "The app is tested every day.",
              "translation": "La aplicación se prueba todos los días.",
              "mirror": {
                "say": "La aplicación se prueba todos los días",
                "pieces": [
                  {
                    "es": "La aplicación",
                    "en": "The app",
                    "role": "who"
                  },
                  {
                    "es": "es",
                    "en": "is",
                    "role": "helper",
                    "from": "se",
                    "why": "«Se prueba» se dice «es probada»: IS + participio."
                  },
                  {
                    "es": "probada",
                    "en": "tested",
                    "role": "verb",
                    "from": "prueba"
                  },
                  {
                    "es": "cada día",
                    "en": "every day",
                    "role": "word",
                    "from": "todos los días"
                  }
                ]
              }
            },
            {
              "text": "This program was written in Java.",
              "translation": "Este programa se escribió en Java.",
              "mirror": {
                "say": "Este programa se escribió en Java",
                "pieces": [
                  {
                    "es": "Este programa",
                    "en": "This program",
                    "role": "who"
                  },
                  {
                    "es": "fue",
                    "en": "was",
                    "role": "helper",
                    "from": "se",
                    "why": "En pasado, el «se» es WAS: was written."
                  },
                  {
                    "es": "escrito",
                    "en": "written",
                    "role": "verb",
                    "from": "escribió"
                  },
                  {
                    "es": "en Java",
                    "en": "in Java",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "The bug was found by Ana.",
              "translation": "Ana encontró el fallo."
            },
            {
              "text": "English is spoken here.",
              "translation": "Aquí se habla inglés."
            }
          ],
          "pitfalls": [
            "«The app is test» está mal: detrás de is / was va el participio (tested, written).",
            "El «se» no se traduce: se convierte en IS o WAS."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "El objeto RECIBE la acción: IS + participio.",
            "emoji": "📦"
          }
        },
        {
          "key": "g-formal-email",
          "type": "pattern",
          "goal": "Escribir un correo formal",
          "rule": "Empieza con Dear + nombre, di para qué escribes (I'm writing to…), pide con COULD y despídete con Best regards.",
          "pieces": [
            {
              "text": "I'm writing to",
              "role": "fixed",
              "hint": "Te escribo para"
            },
            {
              "text": "ask about the job",
              "role": "slot",
              "hint": "preguntar por el puesto"
            }
          ],
          "examples": [
            {
              "text": "I'm writing to ask about the job.",
              "translation": "Te escribo para preguntar por el puesto.",
              "mirror": {
                "say": "Te escribo para preguntar por el puesto",
                "pieces": [
                  {
                    "es": "(YO) estoy escribiendo",
                    "en": "I'm writing",
                    "role": "verb",
                    "from": "te escribo",
                    "why": "En un correo se dice «estoy escribiendo»: I'm writing to…"
                  },
                  {
                    "es": "para",
                    "en": "to",
                    "role": "word"
                  },
                  {
                    "es": "preguntar",
                    "en": "ask",
                    "role": "verb"
                  },
                  {
                    "es": "sobre el puesto",
                    "en": "about the job",
                    "role": "word",
                    "from": "por el puesto"
                  }
                ]
              }
            },
            {
              "text": "Could you send me the report?",
              "translation": "¿Podrías enviarme el informe?",
              "mirror": {
                "say": "¿Podrías enviarme el informe?",
                "pieces": [
                  {
                    "es": "TÚ",
                    "en": "you",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "podrías",
                    "en": "Could",
                    "role": "helper"
                  },
                  {
                    "es": "enviar",
                    "en": "send",
                    "role": "verb",
                    "from": "enviarme",
                    "why": "Lo pegado se separa: send ME."
                  },
                  {
                    "es": "me",
                    "en": "me",
                    "role": "word"
                  },
                  {
                    "es": "el informe",
                    "en": "the report",
                    "role": "word"
                  }
                ],
                "order": [
                  1,
                  0,
                  2,
                  3,
                  4
                ]
              }
            },
            {
              "text": "Dear Ms Smith,",
              "translation": "Estimada Sra. Smith:"
            },
            {
              "text": "Best regards, Luis",
              "translation": "Un saludo, Luis"
            }
          ],
          "pitfalls": [
            "En un correo, «Dear» no es cariñoso: es «Estimado/a».",
            "Formal: Dear Mr / Ms + apellido; nunca «Hello Sir»."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "El CARTERO solo entrega correos que empiezan con DEAR.",
            "emoji": "✉️"
          }
        },
