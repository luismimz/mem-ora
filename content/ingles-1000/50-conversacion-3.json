      "key": "50-conversacion-3",
      "title": "Misión 50 · Proponer, felicitar y animar",
      "units": [
        {
          "key": "g-how-about",
          "type": "pattern",
          "goal": "¿Qué tal si…? = HOW ABOUT + -ING?",
          "rule": "Para proponer: How about + -ING? (how about going out?) o What about…? También: Why don't we…?",
          "pieces": [
            {
              "text": "How about",
              "role": "fixed",
              "hint": "¿qué tal si"
            },
            {
              "text": "going out",
              "role": "slot",
              "hint": "salimos"
            }
          ],
          "examples": [
            {
              "text": "How about going to the cinema?",
              "translation": "¿Qué tal si vamos al cine?",
              "mirror": {
                "say": "¿Qué tal si vamos al cine?",
                "pieces": [
                  {
                    "es": "Qué tal si",
                    "en": "How about",
                    "role": "word"
                  },
                  {
                    "es": "v-AMOS",
                    "en": "go-ING",
                    "role": "verb",
                    "from": "vamos",
                    "why": "Detrás de how about, el verbo en -ING: going."
                  },
                  {
                    "es": "al cine",
                    "en": "to the cinema",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "Why don't we eat out?",
              "translation": "¿Por qué no comemos fuera?",
              "mirror": {
                "say": "¿Por qué no comemos fuera?",
                "pieces": [
                  {
                    "es": "Por qué",
                    "en": "Why",
                    "role": "word"
                  },
                  {
                    "es": "no",
                    "en": "don't",
                    "role": "helper"
                  },
                  {
                    "es": "NOSOTROS",
                    "en": "we",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "comemos fuera",
                    "en": "eat out",
                    "role": "verb"
                  }
                ]
              }
            },
            {
              "text": "What about you?",
              "translation": "¿Y tú?"
            },
            {
              "text": "How about tomorrow?",
              "translation": "¿Qué tal mañana?"
            }
          ],
          "pitfalls": [
            "«How about go?» está mal: How about GOING?",
            "«Why don't we…?» es proponer, no preguntar el motivo."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "HOW ABOUT abre la PUERTA al verbo con -ING.",
            "emoji": "🎉"
          }
        },
        {
