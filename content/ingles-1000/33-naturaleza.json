      "title": "Misión 33 · La naturaleza",
      "units": [
        {
          "key": "g-mente-ly",
          "type": "pattern",
          "goal": "-MENTE = -LY: rápidamente = quickly",
          "rule": "Si en español acaba en -mente, en inglés suele acabar en -LY: lentamente = slowly, perfectamente = perfectly. Ojo: bien = well.",
          "pieces": [
            {
              "text": "slow",
              "role": "slot",
              "hint": "lenta"
            },
            {
              "text": "-ly",
              "role": "fixed",
              "hint": "-mente"
            }
          ],
          "examples": [
            {
              "text": "Drive slowly.",
              "translation": "Conduce lentamente.",
              "mirror": {
                "say": "Conduce lentamente",
                "pieces": [
                  {
                    "es": "Conduce",
                    "en": "Drive",
                    "role": "verb"
                  },
                  {
                    "es": "lenta-MENTE",
                    "en": "slow-LY",
                    "role": "word",
                    "from": "lentamente",
                    "why": "-MENTE = -LY: slowly."
                  }
                ]
              }
            },
            {
              "text": "She speaks English perfectly.",
              "translation": "Habla inglés perfectamente.",
              "mirror": {
                "say": "Habla inglés perfectamente",
                "pieces": [
                  {
                    "es": "ELLA",
                    "en": "She",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "habla",
                    "en": "speaks",
                    "role": "verb"
                  },
                  {
                    "es": "inglés",
                    "en": "English",
                    "role": "word"
                  },
                  {
                    "es": "perfecta-MENTE",
                    "en": "perfect-LY",
                    "role": "word",
                    "from": "perfectamente",
                    "why": "-MENTE = -LY: perfectly."
                  }
                ]
              }
            },
            {
              "text": "Come quickly!",
              "translation": "¡Ven rápido!"
            },
            {
              "text": "You play very well.",
              "translation": "Juegas muy bien."
            }
          ],
          "pitfalls": [
            "Bien no es «goodly»: es WELL (you play well).",
            "Algunas no cambian: fast, hard (he runs fast)."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "Cada -MENTE se cambia el sombrero por un -LY.",
            "emoji": "🎩"
          }
        },
