      "units": [
        {
          "key": "g-deduction",
          "type": "pattern",
          "goal": "Debe de estar en casa = she MUST be at home",
          "rule": "Para suponer: MUST (seguro que sí), MIGHT o COULD (quizá), CAN'T (seguro que no) + verbo. She must be tired. It can't be true.",
          "pieces": [
            {
              "text": "She",
              "role": "fixed",
              "hint": "ella"
            },
            {
              "text": "must",
              "role": "fixed",
              "hint": "debe de"
            },
            {
              "text": "be tired",
              "role": "slot",
              "hint": "estar cansada"
            }
          ],
          "examples": [
            {
              "text": "She must be at home.",
              "translation": "Debe de estar en casa.",
              "mirror": {
                "say": "Debe de estar en casa",
                "pieces": [
                  {
                    "es": "ELLA",
                    "en": "She",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "debe de",
                    "en": "must",
                    "role": "helper",
                    "from": "Debe de",
                    "why": "Para suponer que seguro que sí: MUST."
                  },
                  {
                    "es": "estar",
                    "en": "be",
                    "role": "verb"
                  },
                  {
                    "es": "en casa",
                    "en": "at home",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "That can't be true!",
              "translation": "¡No puede ser verdad!",
              "mirror": {
                "say": "¡No puede ser verdad!",
                "pieces": [
                  {
                    "es": "ESO",
                    "en": "That",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "no puede",
                    "en": "can't",
                    "role": "helper",
                    "from": "No puede",
                    "why": "Para «seguro que no»: CAN'T."
                  },
                  {
                    "es": "ser",
                    "en": "be",
                    "role": "verb"
                  },
                  {
                    "es": "verdadero",
                    "en": "true",
                    "role": "word",
                    "from": "verdad",
                    "why": "Ser verdad es «be true» (adjetivo)."
                  }
                ]
              }
            },
            {
              "text": "It might rain later.",
              "translation": "Puede que llueva luego."
            },
            {
              "text": "He could be lost.",
              "translation": "Quizá se ha perdido."
            }
          ],
          "pitfalls": [
            "«She must to be» está mal: detrás de must, el verbo tal cual.",
            "Para «seguro que no» se dice CAN'T, no mustn't."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "Un DETECTIVE con LUPA: MUST, MIGHT o CAN'T.",
            "emoji": "🔍"
          }
        },
