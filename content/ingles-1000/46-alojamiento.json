      "key": "46-alojamiento",
      "title": "Misión 46 · En el hotel y de turismo",
      "units": [
        {
          "key": "g-would-like",
          "type": "pattern",
          "goal": "Me gustaría = I'D LIKE TO",
          "rule": "«Me gustaría + verbo» = I'd like TO + verbo: I'd like to book a room. Más educado que «I want».",
          "pieces": [
            {
              "text": "I'd like to",
              "role": "fixed",
              "hint": "me gustaría"
            },
            {
              "text": "book a room",
              "role": "slot",
              "hint": "reservar una habitación"
            }
          ],
          "examples": [
            {
              "text": "I'd like to book a room.",
              "translation": "Me gustaría reservar una habitación.",
              "mirror": {
                "say": "Me gustaría reservar una habitación",
                "pieces": [
                  {
                    "es": "(YO) querría",
                    "en": "I'd like",
                    "role": "verb",
                    "from": "me gustaría",
                    "why": "«Me gustaría» = I'd like: más educado que want."
                  },
                  {
                    "es": "reservar",
                    "en": "to book",
                    "role": "verb"
                  },
                  {
                    "es": "una habitación",
                    "en": "a room",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "Would you like to come?",
              "translation": "¿Te gustaría venir?",
              "mirror": {
                "say": "¿Te gustaría venir?",
                "pieces": [
                  {
                    "es": "TÚ",
                    "en": "you",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "-RÍAS",
                    "en": "Would",
                    "role": "helper",
                    "from": "te gustaría",
                    "why": "-RÍA = WOULD: would you like…?"
                  },
                  {
                    "es": "gustar",
                    "en": "like",
                    "role": "verb"
                  },
                  {
                    "es": "venir",
                    "en": "to come",
                    "role": "verb"
                  }
                ],
                "order": [
                  1,
                  0,
                  2,
                  3
                ]
              }
            },
            {
              "text": "I'd like a window seat.",
              "translation": "Quisiera un asiento de ventanilla."
            },
            {
              "text": "We'd like to see the menu.",
              "translation": "Nos gustaría ver la carta."
            }
          ],
          "pitfalls": [
            "«I'd like go» está mal: con un verbo, I'd like TO go.",
            "«I like» (me gusta) no es «I'd like» (me gustaría)."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "La -RÍA viaja con WOULD y TO de equipaje.",
            "emoji": "🛎️"
          }
        },
