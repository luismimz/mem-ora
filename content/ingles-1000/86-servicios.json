      "key": "86-servicios",
      "title": "Misión 86 · Que te lo hagan (B1)",
      "units": [
        {
          "key": "g-have-done",
          "type": "pattern",
          "goal": "Me corté el pelo (me lo cortaron) = I HAD my hair CUT",
          "rule": "Cuando otro lo hace por ti: have + cosa + participio. I had my hair cut. I'm having my car repaired. (I cut my hair: me lo corté yo.)",
          "pieces": [
            {
              "text": "I had",
              "role": "fixed",
              "hint": "me hice"
            },
            {
              "text": "my hair",
              "role": "slot",
              "hint": "el pelo"
            },
            {
              "text": "cut",
              "role": "fixed",
              "hint": "cortar"
            }
          ],
          "examples": [
            {
              "text": "I had my hair cut yesterday.",
              "translation": "Ayer me corté el pelo.",
              "mirror": {
                "say": "Ayer me corté el pelo",
                "pieces": [
                  {
                    "es": "ayer",
                    "en": "yesterday",
                    "role": "word"
                  },
                  {
                    "es": "(YO) tuve",
                    "en": "I had",
                    "role": "helper",
                    "from": "me",
                    "why": "En la peluquería te lo hace otro: have + cosa + participio."
                  },
                  {
                    "es": "cortado",
                    "en": "cut",
                    "role": "verb",
                    "from": "corté"
                  },
                  {
                    "es": "MI pelo",
                    "en": "my hair",
                    "role": "word",
                    "from": "el pelo"
                  }
                ],
                "order": [
                  1,
                  3,
                  2,
                  0
                ]
              }
            },
            {
              "text": "We're having the kitchen painted.",
              "translation": "Nos están pintando la cocina.",
              "mirror": {
                "say": "Nos están pintando la cocina",
                "pieces": [
                  {
                    "es": "(NOSOTROS) estamos",
                    "en": "We're",
                    "role": "helper",
                    "from": "Nos están"
                  },
                  {
                    "es": "teniendo",
                    "en": "having",
                    "role": "verb",
                    "from": "pintando"
                  },
                  {
                    "es": "la cocina",
                    "en": "the kitchen",
                    "role": "word"
                  },
                  {
                    "es": "pintada",
                    "en": "painted",
                    "role": "verb",
                    "from": "pintando",
                    "why": "Si te lo hace otro: have + cosa + participio."
                  }
                ]
              }
            },
            {
              "text": "Where do you get your car repaired?",
              "translation": "¿Dónde te arreglan el coche?"
            },
            {
              "text": "I need to have my eyes tested.",
              "translation": "Tengo que revisarme la vista."
            }
          ],
          "pitfalls": [
            "«I cut my hair» es que te lo cortaste tú mismo.",
            "El orden es have + cosa + participio (no have + participio + cosa)."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "Tú en el SOFÁ; OTRO lo hace: HAVE IT DONE.",
            "emoji": "🛋️"
          }
        },
