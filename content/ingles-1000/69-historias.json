      "units": [
        {
          "key": "g-past-perfect",
          "type": "pattern",
          "goal": "Ya había salido = it HAD LEFT",
          "rule": "Para lo que pasó ANTES de otro pasado: had + participio. When I arrived, the train had left (primero salió el tren).",
          "pieces": [
            {
              "text": "had",
              "role": "fixed",
              "hint": "había"
            },
            {
              "text": "left",
              "role": "slot",
              "hint": "salido"
            }
          ],
          "examples": [
            {
              "text": "When I arrived, the train had left.",
              "translation": "Cuando llegué, el tren ya había salido.",
              "mirror": {
                "say": "Cuando llegué, el tren ya había salido",
                "pieces": [
                  {
                    "es": "Cuando",
                    "en": "When",
                    "role": "word"
                  },
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "llegué",
                    "en": "arrived",
                    "role": "verb"
                  },
                  {
                    "es": "el tren",
                    "en": "the train",
                    "role": "who"
                  },
                  {
                    "es": "había",
                    "en": "had",
                    "role": "helper",
                    "from": "ya había",
                    "why": "Lo que pasó ANTES de otro pasado: had + participio."
                  },
                  {
                    "es": "salido",
                    "en": "left",
                    "role": "verb"
                  }
                ]
              }
            },
            {
              "text": "I realised I had forgotten my keys.",
              "translation": "Me di cuenta de que había olvidado las llaves.",
              "mirror": {
                "say": "Me di cuenta de que había olvidado las llaves",
                "pieces": [
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "me di cuenta",
                    "en": "realised",
                    "role": "verb"
                  },
                  {
                    "es": "(YO) había",
                    "en": "I had",
                    "role": "helper",
                    "from": "de que había"
                  },
                  {
                    "es": "olvidado",
                    "en": "forgotten",
                    "role": "verb"
                  },
                  {
                    "es": "MIS llaves",
                    "en": "my keys",
                    "role": "word",
                    "from": "las llaves",
                    "why": "En inglés las llaves son MÍAS: my keys."
                  }
                ]
              }
            },
            {
              "text": "She had never seen the sea.",
              "translation": "Nunca había visto el mar."
            },
            {
              "text": "By ten, everyone had gone.",
              "translation": "A las diez ya se habían ido todos."
            }
          ],
          "pitfalls": [
            "«When I arrived, the train left» cambia el sentido: salió al llegar tú.",
            "Had + participio vale para todos: I had, she had, they had."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "HAD es una FLECHA que apunta MÁS ATRÁS del pasado.",
            "emoji": "⏮️"
          }
        },
