      "key": "44-opiniones",
      "title": "Misión 44 · Dar tu opinión",
      "units": [
        {
          "key": "g-agree",
          "type": "pattern",
          "goal": "Estoy de acuerdo = I AGREE (sin am)",
          "rule": "«Estoy de acuerdo» es solo I agree (no «I am agree»). En desacuerdo: I don't agree. Para opinar: I think…, in my opinion…",
          "pieces": [
            {
              "text": "I",
              "role": "fixed",
              "hint": "YO"
            },
            {
              "text": "agree",
              "role": "slot",
              "hint": "estoy de acuerdo"
            }
          ],
          "examples": [
            {
              "text": "I agree with you.",
              "translation": "Estoy de acuerdo contigo.",
              "mirror": {
                "say": "Estoy de acuerdo contigo",
                "pieces": [
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "acuerdo",
                    "en": "agree",
                    "role": "verb",
                    "from": "estoy de acuerdo",
                    "why": "«Estar de acuerdo» es un solo verbo: AGREE (sin am)."
                  },
                  {
                    "es": "contigo",
                    "en": "with you",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "I don't agree.",
              "translation": "No estoy de acuerdo.",
              "mirror": {
                "say": "No estoy de acuerdo",
                "pieces": [
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "no",
                    "en": "don't",
                    "role": "helper"
                  },
                  {
                    "es": "acuerdo",
                    "en": "agree",
                    "role": "verb",
                    "from": "estoy de acuerdo"
                  }
                ]
              }
            },
            {
              "text": "In my opinion, it's too expensive.",
              "translation": "En mi opinión, es demasiado caro."
            },
            {
              "text": "What do you think?",
              "translation": "¿Qué opinas?"
            }
          ],
          "pitfalls": [
            "«I am agree» está mal: AGREE ya es «estar de acuerdo».",
            "«On my opinion» está mal: IN my opinion."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "Dos manos se chocan y gritan AGREE, sin AM.",
            "emoji": "🤝"
          }
        },
