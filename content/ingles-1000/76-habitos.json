  "modules": [
    {
      "key": "76-habitos",
      "title": "Misión 76 · Hábitos (B1)",
      "units": [
        {
          "key": "g-gerund-inf",
          "type": "pattern",
          "goal": "Disfruto leyendo / Decidí ir: ENJOY + -ING, DECIDE + TO",
          "rule": "Unos verbos piden -ING (enjoy, avoid, mind, finish, can't stand) y otros TO (decide, want, hope, plan). I enjoy reading. I decided to go.",
          "pieces": [
            {
              "text": "I enjoy",
              "role": "fixed",
              "hint": "disfruto"
            },
            {
              "text": "reading",
              "role": "slot",
              "hint": "leyendo"
            }
          ],
          "examples": [
            {
              "text": "I enjoy reading in bed.",
              "translation": "Disfruto leyendo en la cama.",
              "mirror": {
                "say": "Disfruto leyendo en la cama",
                "pieces": [
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "disfruto",
                    "en": "enjoy",
                    "role": "verb"
                  },
                  {
                    "es": "leyendo",
                    "en": "reading",
                    "role": "verb",
                    "from": "leyendo",
                    "why": "Detrás de enjoy, -ING: enjoy reading."
                  },
                  {
                    "es": "en cama",
                    "en": "in bed",
                    "role": "word",
                    "from": "en la cama",
                    "why": "En la cama es IN bed, sin «the»."
                  }
                ]
              }
            },
            {
              "text": "We decided to stay at home.",
              "translation": "Decidimos quedarnos en casa.",
              "mirror": {
                "say": "Decidimos quedarnos en casa",
                "pieces": [
                  {
                    "es": "NOSOTROS",
                    "en": "We",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "decidimos",
                    "en": "decided",
                    "role": "verb"
                  },
                  {
                    "es": "a quedar",
                    "en": "to stay",
                    "role": "verb",
                    "from": "quedarnos",
                    "why": "Detrás de decide, TO + verbo: decided to stay."
                  },
                  {
                    "es": "en casa",
                    "en": "at home",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "I can't stand waiting.",
              "translation": "No soporto esperar."
            },
            {
              "text": "I hope to see you soon.",
              "translation": "Espero verte pronto."
            }
          ],
          "pitfalls": [
            "«I enjoy to read» está mal: enjoy + -ING.",
            "«I decided going» está mal: decide + TO."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "ENJOY lleva un -ING en la MOCHILA; DECIDE, un TO.",
            "emoji": "🔀"
          }
        },
