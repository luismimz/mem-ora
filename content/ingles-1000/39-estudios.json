        {
          "key": "g-have-to",
          "type": "pattern",
          "goal": "Tener que = HAVE TO",
          "rule": "«Tengo que + verbo» = I have to + verbo: I have to study. Él o ella: HAS to. «No tengo que» (no hace falta) = I don't have to.",
          "pieces": [
            {
              "text": "I have to",
              "role": "fixed",
              "hint": "tengo que"
            },
            {
              "text": "study",
              "role": "slot",
              "hint": "estudiar"
            }
          ],
          "examples": [
            {
              "text": "I have to study tonight.",
              "translation": "Tengo que estudiar esta noche.",
              "mirror": {
                "say": "Tengo que estudiar esta noche",
                "pieces": [
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "tengo que",
                    "en": "have to",
                    "role": "helper"
                  },
                  {
                    "es": "estudiar",
                    "en": "study",
                    "role": "verb"
                  },
                  {
                    "es": "esta noche",
                    "en": "tonight",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "She has to work on Saturday.",
              "translation": "Tiene que trabajar el sábado.",
              "mirror": {
                "say": "Tiene que trabajar el sábado",
                "pieces": [
                  {
                    "es": "ELLA",
                    "en": "She",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "tiene que",
                    "en": "has to",
                    "role": "helper"
                  },
                  {
                    "es": "trabajar",
                    "en": "work",
                    "role": "verb"
                  },
                  {
                    "es": "en sábado",
                    "en": "on Saturday",
                    "role": "word",
                    "from": "el sábado",
                    "why": "Los días llevan ON: on Monday, on Fridays."
                  }
                ]
              }
            },
            {
              "text": "You don't have to come.",
              "translation": "No hace falta que vengas."
            },
            {
              "text": "Do I have to pay?",
              "translation": "¿Tengo que pagar?"
            }
