      "key": "63-conversacion-4",
      "title": "Misión 63 · Muletillas para charlar",
      "units": [
        {
          "key": "g-tag",
          "type": "pattern",
          "goal": "…, ¿verdad? = …, ISN'T IT?",
          "rule": "Para que te den la razón se repite el verbo al revés: It's cold, isn't it? You like it, don't you? It isn't far, is it?",
          "pieces": [
            {
              "text": "It's cold",
              "role": "slot",
              "hint": "hace frío"
            },
            {
              "text": "isn't it",
              "role": "fixed",
              "hint": "¿verdad"
            }
          ],
          "examples": [
            {
              "text": "It's cold, isn't it?",
              "translation": "Hace frío, ¿verdad?",
              "mirror": {
                "say": "Hace frío, ¿verdad?",
                "pieces": [
                  {
                    "es": "(ESO) es",
                    "en": "It's",
                    "role": "helper",
                    "from": "Hace",
                    "why": "El tiempo va con IT IS: it's cold."
                  },
                  {
                    "es": "frío",
                    "en": "cold",
                    "role": "word"
                  },
                  {
                    "es": "no es ESO",
                    "en": "isn't it",
                    "role": "helper",
                    "from": "verdad",
                    "why": "«¿Verdad?» repite el verbo al revés: isn't it?"
                  }
                ]
              }
            },
            {
              "text": "You like pizza, don't you?",
              "translation": "Te gusta la pizza, ¿verdad?",
              "mirror": {
                "say": "Te gusta la pizza, ¿verdad?",
                "pieces": [
                  {
                    "es": "TÚ",
                    "en": "you",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "gustas",
                    "en": "like",
                    "role": "verb",
                    "from": "Te gusta",
                    "why": "Gustar se da la vuelta: you like…"
                  },
                  {
                    "es": "pizza",
                    "en": "pizza",
                    "role": "word",
                    "from": "la pizza",
                    "why": "Hablando en general, sin «the»."
                  },
                  {
                    "es": "no TÚ",
                    "en": "don't you",
                    "role": "helper",
                    "from": "verdad",
                    "why": "Con like el ayudante es DO: don't you?"
                  }
                ]
              }
            },
            {
              "text": "She's here, isn't she?",
              "translation": "Está aquí, ¿no?"
            },
            {
              "text": "You can swim, can't you?",
              "translation": "Sabes nadar, ¿verdad?"
            }
          ],
          "pitfalls": [
            "Si la frase es afirmativa, la coletilla va en negativo (y al revés).",
            "Si dudas, «right?» también vale: It's cold, right?"
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "Un BOOMERANG: el VERBO va y vuelve al REVÉS.",
            "emoji": "🪃"
          }
        },
        {
