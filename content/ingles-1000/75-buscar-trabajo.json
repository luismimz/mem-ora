      "key": "75-buscar-trabajo",
      "title": "Misión 75 · Buscar trabajo (B1)",
      "units": [
        {
          "key": "g-pp-continuous",
          "type": "pattern",
          "goal": "Llevo dos horas estudiando = I'VE BEEN studying",
          "rule": "Para algo que empezó antes y sigue: have been + -ING + for/since. I've been studying for two hours. How long have you been waiting?",
          "pieces": [
            {
              "text": "I've been",
              "role": "fixed",
              "hint": "llevo"
            },
            {
              "text": "studying",
              "role": "slot",
              "hint": "estudiando"
            },
            {
              "text": "for two hours",
              "role": "fixed",
              "hint": "dos horas"
            }
          ],
          "examples": [
            {
              "text": "I've been studying for two hours.",
              "translation": "Llevo dos horas estudiando.",
              "mirror": {
                "say": "Llevo dos horas estudiando",
                "pieces": [
                  {
                    "es": "(YO) he estado",
                    "en": "I've been",
                    "role": "helper",
                    "from": "Llevo",
                    "why": "«Llevo… -ando» es «he estado… -ing»: I've been studying."
                  },
                  {
                    "es": "durante dos horas",
                    "en": "for two hours",
                    "role": "word",
                    "from": "dos horas"
                  },
                  {
                    "es": "estudiando",
                    "en": "studying",
                    "role": "verb"
                  }
                ],
                "order": [
                  0,
                  2,
                  1
                ]
              }
            },
            {
              "text": "How long have you been waiting?",
              "translation": "¿Cuánto tiempo llevas esperando?",
              "mirror": {
                "say": "¿Cuánto tiempo llevas esperando?",
                "pieces": [
                  {
                    "es": "Cuánto tiempo",
                    "en": "How long",
                    "role": "word"
                  },
                  {
                    "es": "has",
                    "en": "have",
                    "role": "helper",
                    "from": "llevas"
                  },
                  {
                    "es": "TÚ",
                    "en": "you",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "estado",
                    "en": "been",
                    "role": "helper",
                    "from": "llevas"
                  },
                  {
                    "es": "esperando",
                    "en": "waiting",
                    "role": "verb"
                  }
                ]
              }
            },
            {
              "text": "She's been working here since May.",
              "translation": "Trabaja aquí desde mayo."
            },
            {
              "text": "It's been raining all day.",
              "translation": "Lleva lloviendo todo el día."
            }
          ],
          "pitfalls": [
            "«I am studying for two hours» está mal: si dura hasta ahora, I've been studying.",
            "Con verbos como know o like, sin -ING: I've known her for years."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "Un CRONÓMETRO que sigue CORRIENDO: I'VE BEEN + -ING.",
            "emoji": "🔄"
          }
        },
