          "key": "g-jobs",
          "type": "pattern",
          "goal": "Soy médico = I'M A DOCTOR",
          "rule": "Al decir tu trabajo, siempre A (o AN): I'm a doctor, she's an engineer. Para preguntar: What do you do?",
          "pieces": [
            {
              "text": "I'm",
              "role": "fixed",
              "hint": "soy"
            },
            {
              "text": "a",
              "role": "fixed",
              "hint": "(un, una)"
            },
            {
              "text": "nurse",
              "role": "slot",
              "hint": "enfermero"
            }
          ],
          "examples": [
            {
              "text": "I'm a programmer.",
              "translation": "Soy programador.",
              "mirror": {
                "say": "Soy programador",
                "pieces": [
                  {
                    "es": "(YO) soy",
                    "en": "I'm",
                    "role": "helper"
                  },
                  {
                    "es": "un programador",
                    "en": "a programmer",
                    "role": "word",
                    "from": "programador",
                    "why": "Tu trabajo siempre lleva A: a programmer."
                  }
                ]
              }
            },
            {
              "text": "What do you do?",
              "translation": "¿A qué te dedicas?",
              "mirror": {
                "say": "¿A qué te dedicas?",
                "pieces": [
                  {
                    "es": "Qué",
                    "en": "What",
                    "role": "word",
                    "from": "A qué"
                  },
                  {
                    "es": "",
                    "en": "do",
                    "role": "signal"
                  },
                  {
                    "es": "TÚ",
                    "en": "you",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "haces",
                    "en": "do",
                    "role": "verb",
                    "from": "te dedicas",
                    "why": "«¿A qué te dedicas?» es «¿qué haces?»: what do you do?"
                  }
                ]
              }
            },
            {
              "text": "She's an engineer.",
              "translation": "Es ingeniera."
            },
            {
              "text": "He works as a waiter.",
              "translation": "Trabaja de camarero."
            }
          ],
          "practice": [
