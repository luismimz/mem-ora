      "units": [
        {
          "key": "g-first-conditional",
          "type": "pattern",
          "goal": "Si llueve, me quedo = IF it rains, I'LL stay",
          "rule": "Para lo que pasará si…: IF + presente, y WILL + verbo. If it rains, I'll stay at home. Detrás de if, nunca will.",
          "pieces": [
            {
              "text": "If it rains",
              "role": "slot",
              "hint": "si llueve"
            },
            {
              "text": "I'll stay",
              "role": "fixed",
              "hint": "me quedo"
            }
          ],
          "examples": [
            {
              "text": "If it rains, I'll stay at home.",
              "translation": "Si llueve, me quedo en casa.",
              "mirror": {
                "say": "Si llueve, me quedo en casa",
                "pieces": [
                  {
                    "es": "Si",
                    "en": "If",
                    "role": "word"
                  },
                  {
                    "es": "ESO llueve",
                    "en": "it rains",
                    "role": "verb",
                    "from": "llueve",
                    "why": "Llover necesita su IT: it rains."
                  },
                  {
                    "es": "(YO) -RÉ",
                    "en": "I'll",
                    "role": "helper",
                    "from": "me",
                    "why": "Lo que pasará va con WILL: I'll stay."
                  },
                  {
                    "es": "quedar",
                    "en": "stay",
                    "role": "verb",
                    "from": "quedo"
                  },
                  {
                    "es": "en casa",
                    "en": "at home",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "If you hurry, you'll catch the bus.",
              "translation": "Si te das prisa, pillas el bus.",
              "mirror": {
                "say": "Si te das prisa, pillas el bus",
                "pieces": [
                  {
                    "es": "Si",
                    "en": "If",
                    "role": "word"
                  },
                  {
                    "es": "TÚ",
                    "en": "you",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "te das prisa",
                    "en": "hurry",
                    "role": "verb"
                  },
                  {
                    "es": "(TÚ) cogerás",
                    "en": "you'll catch",
                    "role": "verb",
                    "from": "pillas",
                    "why": "Lo que pasará va con WILL: you'll catch."
                  },
                  {
                    "es": "el bus",
                    "en": "the bus",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "I'll call you if I can.",
              "translation": "Te llamo si puedo."
            },
            {
              "text": "What will you do if you fail?",
              "translation": "¿Qué harás si suspendes?"
            }
          ],
          "pitfalls": [
            "«If it will rain» está mal: detrás de if, presente (if it rains).",
            "Se puede dar la vuelta: I'll stay at home if it rains."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "IF abre el PARAGUAS y WILL se queda en CASA.",
            "emoji": "☔"
          },
          "tense": "Primer condicional",
          "timeline": [
            {
              "kind": "event",
              "at": 1.6,
              "label": "si pasa, pasará"
            }
          ],
          "signals": [
            "if + presente",
            "unless",
            "as soon as"
          ],
          "drills": [
            {
              "text": "If it rains, I ___ (stay) at home.",
              "answer": "will stay",
              "wrong": [
                "would stay",
                "stayed"
              ],
              "signal": "If it rains",
              "es": "Si llueve, me quedaré en casa."
            },
            {
              "text": "If you ___ (hurry), you'll catch the bus.",
              "answer": "hurry",
              "wrong": [
                "will hurry",
                "hurried"
              ],
              "signal": "you'll catch",
              "es": "Si te das prisa, cogerás el autobús."
            },
            {
              "text": "I'll call you if I ___ (have) time.",
              "answer": "have",
              "wrong": [
                "will have",
                "had"
              ],
              "signal": "I'll call you if",
              "es": "Te llamaré si tengo tiempo."
            }
          ]
        },
