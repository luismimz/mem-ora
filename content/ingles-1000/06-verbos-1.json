          "key": "g-present-simple",
          "type": "pattern",
          "goal": "Decir lo que te gusta, quieres o necesitas",
          "rule": "Con I, you, we, they el verbo va tal cual: I like music. «Me gusta» se dice al revés: YO gusto → I like.",
          "pieces": [
            {
              "text": "I",
              "role": "fixed",
              "hint": "YO"
            },
            {
              "text": "like",
              "role": "slot",
              "hint": "gusto (me gusta)"
            },
            {
              "text": "music",
              "role": "fixed",
              "hint": "la música"
            }
          ],
          "examples": [
            {
              "text": "I like music.",
              "translation": "Me gusta la música.",
              "mirror": {
                "say": "Me gusta la música",
                "pieces": [
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "gusto",
                    "en": "like",
                    "role": "verb",
                    "from": "me gusta",
                    "why": "Al revés: YO gusto la música."
                  },
                  {
                    "es": "la música",
                    "en": "music",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "We need help.",
              "translation": "Necesitamos ayuda.",
              "mirror": {
                "say": "Necesitamos ayuda",
                "pieces": [
                  {
                    "es": "NOSOTROS",
                    "en": "We",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "necesitamos",
                    "en": "need",
                    "role": "verb"
                  },
                  {
                    "es": "ayuda",
                    "en": "help",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "They have two cars.",
              "translation": "Tienen dos coches."
            },
            {
              "text": "I want a coffee.",
              "translation": "Quiero un café."
            }
          ],
          "pitfalls": [
            "«Me like» está mal: es I like (YO gusto).",
            "Sin sujeto no hay frase: «Want coffee» está mal; es I want coffee."
