      "key": "41-caracter",
      "title": "Misión 41 · Cómo es la gente",
      "units": [
        {
          "key": "g-what-like",
          "type": "pattern",
          "goal": "¿Cómo es? = WHAT IS SHE LIKE?",
          "rule": "Para preguntar cómo ES alguien (su carácter o su aspecto): What is he like? «How is he?» pregunta cómo ESTÁ.",
          "pieces": [
            {
              "text": "What's",
              "role": "fixed",
              "hint": "¿cómo es"
            },
            {
              "text": "your boss",
              "role": "slot",
              "hint": "tu jefe"
            },
            {
              "text": "like",
              "role": "fixed",
              "hint": "(como)"
            }
          ],
          "examples": [
            {
              "text": "What's your boss like?",
              "translation": "¿Cómo es tu jefe?",
              "mirror": {
                "say": "¿Cómo es tu jefe?",
                "pieces": [
                  {
                    "es": "Qué es",
                    "en": "What's",
                    "role": "word",
                    "from": "Cómo es",
                    "why": "Para preguntar cómo ES alguien: what is he LIKE?"
                  },
                  {
                    "es": "tu jefe",
                    "en": "your boss",
                    "role": "who"
                  },
                  {
                    "es": "como",
                    "en": "like",
                    "role": "word",
                    "ghost": true
                  }
                ]
              }
            },
            {
              "text": "She's very friendly.",
              "translation": "Es muy simpática.",
              "mirror": {
                "say": "Es muy simpática",
                "pieces": [
                  {
                    "es": "(ELLA) es",
                    "en": "She's",
                    "role": "helper"
                  },
                  {
                    "es": "muy simpática",
                    "en": "very friendly",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "What's the weather like?",
              "translation": "¿Qué tiempo hace?"
            },
            {
              "text": "How is he? He's fine.",
              "translation": "¿Cómo está? Bien."
            }
          ],
          "pitfalls": [
            "«How is your boss?» pregunta cómo ESTÁ (de salud), no cómo ES.",
            "En la respuesta no se repite like: She's nice."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "El LIKE espera al FINAL de la pregunta.",
            "emoji": "🙂"
          }
        },
