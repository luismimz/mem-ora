      "key": "29-compras",
      "title": "Misión 29 · De compras",
      "units": [
        {
          "key": "g-can-i-have",
          "type": "pattern",
          "goal": "Pedir en una tienda: CAN I HAVE…?",
          "rule": "Para pedir: Can I have…? o I'd like… (quisiera). Más amable que «I want». Para pagar: Can I pay by card?",
          "pieces": [
            {
              "text": "Can I have",
              "role": "fixed",
              "hint": "¿me pones…?"
            },
            {
              "text": "a coffee",
              "role": "slot",
              "hint": "un café"
            }
          ],
          "examples": [
            {
              "text": "Can I have a coffee, please?",
              "translation": "¿Me pones un café, por favor?",
              "mirror": {
                "say": "¿Me pones un café, por favor?",
                "pieces": [
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "puedo",
                    "en": "Can",
                    "role": "helper"
                  },
                  {
                    "es": "tener",
                    "en": "have",
                    "role": "verb",
                    "from": "me pones",
                    "why": "Para pedir: «¿puedo tener…?» = Can I have…?"
                  },
                  {
                    "es": "un café",
                    "en": "a coffee",
                    "role": "word"
                  },
                  {
                    "es": "por favor",
                    "en": "please",
                    "role": "word"
                  }
                ],
                "order": [
                  1,
                  0,
                  2,
                  3,
                  4
                ]
              }
            },
            {
              "text": "I'd like a ticket to Madrid.",
              "translation": "Quisiera un billete a Madrid.",
              "mirror": {
                "say": "Quisiera un billete a Madrid",
                "pieces": [
                  {
                    "es": "(YO) querría",
                    "en": "I'd like",
                    "role": "verb",
                    "from": "quisiera",
                    "why": "Quisiera = me gustaría: I'd like."
                  },
                  {
                    "es": "un billete",
                    "en": "a ticket",
                    "role": "word"
                  },
                  {
                    "es": "a Madrid",
                    "en": "to Madrid",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "How much is this?",
              "translation": "¿Cuánto cuesta esto?"
            },
            {
              "text": "Just looking, thanks.",
              "translation": "Solo estoy mirando, gracias."
            }
          ],
          "pitfalls": [
            "«I want a coffee» suena brusco al pedir: mejor Can I have…? o I'd like…",
            "«Give me» sin please suena a orden."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "El CAMARERO solo sirve a quien dice CAN I HAVE.",
            "emoji": "🛍️"
          }
        },
