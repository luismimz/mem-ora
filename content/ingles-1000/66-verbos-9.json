        {
          "key": "g-before-ing",
          "type": "pattern",
          "goal": "Antes de salir = BEFORE LEAVING",
          "rule": "Detrás de before, after, without o by, el verbo va en -ING: before leaving, after eating, without saying goodbye.",
          "pieces": [
            {
              "text": "before",
              "role": "fixed",
              "hint": "antes de"
            },
            {
              "text": "leaving",
              "role": "slot",
              "hint": "salir"
            }
          ],
          "examples": [
            {
              "text": "Wash your hands before eating.",
              "translation": "Lávate las manos antes de comer.",
              "mirror": {
                "say": "Lávate las manos antes de comer",
                "pieces": [
                  {
                    "es": "Lava",
                    "en": "Wash",
                    "role": "verb",
                    "from": "Lávate"
                  },
                  {
                    "es": "TUS manos",
                    "en": "your hands",
                    "role": "word",
                    "from": "las manos"
                  },
                  {
                    "es": "antes de",
                    "en": "before",
                    "role": "word"
                  },
                  {
                    "es": "com-IENDO",
                    "en": "eating",
                    "role": "verb",
                    "from": "comer",
                    "why": "Detrás de before, el verbo en -ING: eating."
                  }
                ]
              }
            },
            {
              "text": "He left without saying goodbye.",
              "translation": "Se fue sin despedirse.",
