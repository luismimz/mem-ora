        {
          "key": "g-for-since",
          "type": "pattern",
          "goal": "Desde hace dos días = FOR two days",
          "rule": "FOR + cuánto tiempo (for two days). SINCE + desde cuándo (since Monday). Van con have: I've had a cough for two days.",
          "pieces": [
            {
              "text": "I've had it",
              "role": "fixed",
              "hint": "lo tengo"
            },
            {
              "text": "for",
              "role": "fixed",
              "hint": "desde hace"
            },
            {
              "text": "two days",
              "role": "slot",
              "hint": "dos días"
            }
          ],
          "examples": [
            {
              "text": "I've had a cough for two days.",
              "translation": "Tengo tos desde hace dos días.",
              "mirror": {
                "say": "Tengo tos desde hace dos días",
                "pieces": [
                  {
                    "es": "(YO) he tenido",
                    "en": "I've had",
                    "role": "helper",
                    "from": "Tengo",
                    "why": "Si sigue pasando, va con HAVE: I've had."
                  },
                  {
                    "es": "UNA tos",
                    "en": "a cough",
                    "role": "word",
                    "from": "tos"
                  },
                  {
                    "es": "durante",
                    "en": "for",
                    "role": "word",
                    "from": "desde hace"
                  },
                  {
                    "es": "dos días",
                    "en": "two days",
                    "role": "word"
                  }
                ]
              }
            },
