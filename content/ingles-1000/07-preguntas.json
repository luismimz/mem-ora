        {
          "key": "g-do-questions",
          "type": "pattern",
          "goal": "Hacer preguntas: el ¿ se convierte en DO",
          "rule": "Si la frase no tiene ayudante, la pregunta lo añade: (palabra) + DO + tú + verbo. Where do you live?",
          "pieces": [
            {
              "text": "Where",
              "role": "fixed",
              "hint": "¿Dónde"
            },
            {
              "text": "do",
              "role": "fixed",
              "hint": "¿ → DO"
            },
            {
              "text": "you",
              "role": "fixed",
              "hint": "TÚ"
            },
            {
              "text": "live",
              "role": "slot",
              "hint": "vives"
            }
          ],
          "examples": [
            {
              "text": "Where do you live?",
              "translation": "¿Dónde vives?"
            },
            {
              "text": "Do you like coffee?",
              "translation": "¿Te gusta el café?"
            },
            {
              "text": "What do you want?",
              "translation": "¿Qué quieres?"
            },
            {
              "text": "How do you say this?",
              "translation": "¿Cómo se dice esto?"
            }
          ],
          "pitfalls": [
            "«Where you live?» está mal: falta DO.",
            "Con am / is / are no hace falta DO: Where are you?"
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "El signo ¿ se disfraza de portero y grita DO.",
            "emoji": "🚪"
          }
        },
        {
          "key": "semaforos",
          "type": "concept",
          "name": "Los semáforos: DO, DID, WILL",
          "gist": "No se traducen: avisan del tiempo de la pregunta",
          "definition": "DO, DID y WILL no significan nada: son luces de alarma que avisan de que viene una pregunta y en qué tiempo. DO = presente (¿Comes? → Do you eat?). DID = pasado (¿Fuiste? → Did you go?). WILL = futuro (¿Irás? → Will you go?). Detrás, el verbo va siempre tal cual.",
          "examples": [
            {
              "text": "Do you eat meat?",
              "explanation": "¿Comes carne? · presente → DO."
            },
            {
              "text": "Did you go?",
              "explanation": "¿Fuiste? · pasado → DID."
            },
            {
              "text": "Will you come?",
              "explanation": "¿Vendrás? · futuro → WILL."
            }
          ],
          "contrast": "Con DID el verbo no va en pasado: Did you go? (no «Did you went?»). Con he / she en presente, la alarma es DOES: Does she eat?",
          "exercises": [
            {
              "kind": "apply_case",
              "prompt": "🚦  ¿Comes?",
              "answer": "DO",
              "distractors": [
                "DID",
                "WILL"
              ],
              "explanation": "Presente → Do you eat?"
            },
            {
              "kind": "apply_case",
              "prompt": "🚦  ¿Fuiste?",
              "answer": "DID",
              "distractors": [
                "DO",
                "WILL"
              ],
              "explanation": "Pasado → Did you go?"
            },
            {
              "kind": "apply_case",
              "prompt": "🚦  ¿Irás?",
              "answer": "WILL",
              "distractors": [
                "DO",
                "DID"
              ],
              "explanation": "Futuro → Will you go?"
            },
            {
              "kind": "apply_case",
              "prompt": "🚦  ¿Vives aquí?",
              "answer": "DO",
              "distractors": [
                "DID",
                "WILL"
              ],
              "explanation": "Presente → Do you live here?"
            },
            {
              "kind": "apply_case",
              "prompt": "🚦  ¿Comiste?",
              "answer": "DID",
              "distractors": [
                "DO",
                "WILL"
              ],
              "explanation": "Pasado → Did you eat?"
            },
            {
              "kind": "apply_case",
