      "units": [
        {
          "key": "g-some-any",
          "type": "pattern",
          "goal": "SOME o ANY: ¿hay o no hay?",
          "rule": "SOME en frases normales y al ofrecer (I've got some bread). ANY al preguntar o negar (Is there any milk? I don't have any).",
          "pieces": [
            {
              "text": "Is there",
              "role": "fixed",
              "hint": "¿hay"
            },
            {
              "text": "any",
              "role": "fixed",
              "hint": "(algo de)"
            },
            {
              "text": "milk",
              "role": "slot",
              "hint": "leche"
            }
          ],
          "examples": [
            {
              "text": "Is there any milk?",
              "translation": "¿Hay leche?",
              "mirror": {
                "say": "¿Hay leche?",
                "pieces": [
                  {
                    "es": "Hay",
                    "en": "Is there",
                    "role": "helper"
                  },
                  {
                    "es": "ALGO DE",
                    "en": "any",
                    "role": "word",
                    "ghost": true
                  },
                  {
                    "es": "leche",
                    "en": "milk",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "I bought some bread.",
              "translation": "He comprado pan.",
              "mirror": {
                "say": "He comprado pan",
                "pieces": [
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "compré",
                    "en": "bought",
                    "role": "verb",
                    "from": "He comprado"
                  },
                  {
                    "es": "UN POCO DE",
                    "en": "some",
                    "role": "word",
                    "ghost": true
                  },
                  {
                    "es": "pan",
                    "en": "bread",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "We don't have any towels.",
              "translation": "No tenemos toallas."
            },
            {
              "text": "Would you like some tea?",
              "translation": "¿Quieres un té?"
            }
          ],
          "pitfalls": [
            "«I don't have some» está mal: al negar, any.",
            "Al ofrecer se usa some: would you like some tea?"
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "SOME llena la NEVERA; ANY pregunta si queda.",
            "emoji": "🥛"
          }
        },
