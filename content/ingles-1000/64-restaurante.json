      "key": "64-restaurante",
      "title": "Misión 64 · En el restaurante",
      "units": [
        {
          "key": "g-prefer",
          "type": "pattern",
          "goal": "Prefiero el té al café = I prefer tea TO coffee",
          "rule": "Para preferencias: I prefer A to B (sin «the»). Para elegir ahora: I'd rather + verbo (I'd rather stay).",
          "pieces": [
            {
              "text": "I prefer",
              "role": "fixed",
              "hint": "prefiero"
            },
            {
              "text": "tea",
              "role": "slot",
              "hint": "el té"
            },
            {
              "text": "to coffee",
              "role": "fixed",
              "hint": "al café"
            }
          ],
          "examples": [
            {
              "text": "I prefer tea to coffee.",
              "translation": "Prefiero el té al café.",
              "mirror": {
                "say": "Prefiero el té al café",
                "pieces": [
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "prefiero",
                    "en": "prefer",
                    "role": "verb"
                  },
                  {
                    "es": "té",
                    "en": "tea",
                    "role": "word",
                    "from": "el té",
                    "why": "Hablando en general, sin «the»."
                  },
                  {
                    "es": "a café",
                    "en": "to coffee",
                    "role": "word",
                    "from": "al café",
                    "why": "Preferir A a B: prefer A TO B, sin «the»."
                  }
                ]
              }
            },
            {
              "text": "I'd rather stay at home.",
              "translation": "Prefiero quedarme en casa.",
              "mirror": {
                "say": "Prefiero quedarme en casa",
                "pieces": [
                  {
                    "es": "(YO) -RÍA antes",
                    "en": "I'd rather",
                    "role": "helper",
                    "from": "Prefiero",
                    "why": "Para elegir ahora: I'd rather + verbo."
                  },
                  {
                    "es": "quedar",
                    "en": "stay",
                    "role": "verb",
                    "from": "quedarme"
                  },
                  {
                    "es": "en casa",
                    "en": "at home",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "Which do you prefer?",
              "translation": "¿Cuál prefieres?"
            },
            {
              "text": "I'd rather not.",
              "translation": "Prefiero que no."
            }
          ],
          "pitfalls": [
            "«I prefer tea than coffee» está mal: TO coffee.",
            "Detrás de I'd rather, el verbo va tal cual: I'd rather go."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "Una BALANZA con TÉ arriba y CAFÉ abajo.",
            "emoji": "⚖️"
          }
        },
