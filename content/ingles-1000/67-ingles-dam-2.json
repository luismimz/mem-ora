      "units": [
        {
          "key": "g-how-to",
          "type": "pattern",
          "goal": "Cómo se instala = HOW TO install",
          "rule": "Para buscar instrucciones: how to + verbo. How to install Java. I don't know how to do it. Muy útil al buscar en internet.",
          "pieces": [
            {
              "text": "How to",
              "role": "fixed",
              "hint": "cómo"
            },
            {
              "text": "install Java",
              "role": "slot",
              "hint": "instalar Java"
            }
          ],
          "examples": [
            {
              "text": "How to connect to a database.",
              "translation": "Cómo conectarse a una base de datos.",
              "mirror": {
                "say": "Cómo conectarse a una base de datos",
                "pieces": [
                  {
                    "es": "Cómo",
                    "en": "How",
                    "role": "word"
                  },
                  {
                    "es": "a conectar",
                    "en": "to connect",
                    "role": "verb",
                    "from": "conectarse",
                    "why": "Cómo + verbo es HOW TO + verbo."
                  },
                  {
                    "es": "a una base de datos",
                    "en": "to a database",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "I don't know how to fix this bug.",
              "translation": "No sé cómo arreglar este fallo.",
              "mirror": {
                "say": "No sé cómo arreglar este fallo",
                "pieces": [
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "no",
                    "en": "don't",
                    "role": "helper",
                    "from": "No"
                  },
                  {
                    "es": "sé",
                    "en": "know",
                    "role": "verb"
                  },
                  {
                    "es": "cómo",
                    "en": "how",
                    "role": "word"
                  },
                  {
                    "es": "a arreglar",
                    "en": "to fix",
                    "role": "verb",
                    "from": "arreglar"
                  },
                  {
                    "es": "este fallo",
                    "en": "this bug",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "How to exit Vim?",
              "translation": "¿Cómo se sale de Vim?"
            },
            {
              "text": "She showed me how to use Git.",
              "translation": "Me enseñó a usar Git."
            }
          ],
          "pitfalls": [
            "«How install Java» está mal: falta TO (how to install).",
            "Para preguntar a alguien: How do I install it?"
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "Un MANUAL que se abre gritando: HOW TO!",
            "emoji": "📖"
          }
        },
