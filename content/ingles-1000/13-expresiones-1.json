        {
          "key": "g-polite-requests",
          "type": "pattern",
          "goal": "Pedir algo con educación (could you…?)",
          "rule": "Could you + verbo + please? Es más amable que can. Para pedir para ti: Could I have…?",
          "pieces": [
            {
              "text": "Could",
              "role": "fixed",
              "hint": "¿Podrías"
            },
            {
              "text": "you",
              "role": "fixed",
              "hint": "TÚ"
            },
            {
              "text": "repeat that",
              "role": "slot",
              "hint": "repetirlo"
            },
            {
              "text": "please",
              "role": "fixed",
              "hint": "por favor"
            }
          ],
          "examples": [
            {
              "text": "Could you repeat that, please?",
              "translation": "¿Podrías repetirlo, por favor?"
            },
            {
              "text": "Could you help me?",
              "translation": "¿Podrías ayudarme?"
            },
            {
              "text": "Could I have a coffee, please?",
              "translation": "¿Me pones un café, por favor?"
            },
            {
              "text": "Could you speak slowly?",
              "translation": "¿Podrías hablar despacio?"
            }
          ],
          "pitfalls": [
            "Sin «please» suena brusco: en inglés importa mucho."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "Un mayordomo inglés susurra COULD YOU antes de cada favor.",
            "emoji": "🎩"
          }
        },
