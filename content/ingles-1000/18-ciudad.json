        {
          "key": "g-there-is",
          "type": "pattern",
          "goal": "Decir lo que HAY: there is / there are",
          "rule": "«Hay» es THERE IS (uno) o THERE ARE (varios). Para preguntar, el ayudante salta: Is there a bank near here?",
          "pieces": [
            {
              "text": "There",
              "role": "fixed",
              "hint": "ahí"
            },
            {
              "text": "is",
              "role": "fixed",
              "hint": "hay (uno)"
            },
            {
              "text": "a bank",
              "role": "slot",
              "hint": "un banco"
            }
          ],
          "examples": [
            {
              "text": "There is a bank near here.",
              "translation": "Hay un banco cerca de aquí.",
              "mirror": {
                "say": "Hay un banco cerca de aquí",
                "pieces": [
                  {
                    "es": "hay",
                    "en": "There is",
                    "role": "helper"
                  },
                  {
                    "es": "un banco",
                    "en": "a bank",
                    "role": "word"
                  },
                  {
                    "es": "cerca de aquí",
                    "en": "near here",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "There are two parks in my city.",
              "translation": "Hay dos parques en mi ciudad.",
              "mirror": {
                "say": "Hay dos parques en mi ciudad",
                "pieces": [
                  {
                    "es": "hay (varios)",
                    "en": "There are",
                    "role": "helper",
                    "from": "hay",
                    "why": "Si hay varios, THERE ARE: there are two parks."
                  },
                  {
                    "es": "dos parques",
                    "en": "two parks",
                    "role": "word"
                  },
                  {
                    "es": "en mi ciudad",
                    "en": "in my city",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "Is there a hotel near here?",
              "translation": "¿Hay un hotel cerca de aquí?"
            },
            {
              "text": "There isn't any milk.",
              "translation": "No hay leche."
            },
            {
              "text": "There is an apple on the plate.",
              "translation": "Hay una manzana en el plato.",
              "stage": [
                {
                  "e": "🍽️",
                  "x": 50,
                  "y": 62,
                  "s": 3
                },
                {
                  "e": "🍎",
                  "x": 50,
                  "y": 55,
                  "s": 1.2,
                  "z": 1
                }
              ]
            },
            {
              "text": "There are two apples on the plate.",
              "translation": "Hay dos manzanas en el plato.",
              "stage": [
                {
                  "e": "🍽️",
                  "x": 50,
                  "y": 62,
                  "s": 3
                },
                {
                  "e": "🍎",
                  "x": 40,
                  "y": 55,
                  "s": 1.2,
                  "z": 1
                },
                {
                  "e": "🍎",
                  "x": 60,
                  "y": 55,
                  "s": 1.2,
                  "z": 1
                }
              ]
            },
            {
