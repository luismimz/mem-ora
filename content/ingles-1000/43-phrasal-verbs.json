                  {
                    "es": "rindas",
                    "en": "give up",
                    "role": "verb",
                    "from": "te rindas",
                    "why": "Rendirse es GIVE UP: dos piezas, un significado."
                  }
                ]
              }
            },
            {
              "text": "Turn off the TV.",
              "translation": "Apaga la tele."
            },
            {
              "text": "We went out last night.",
