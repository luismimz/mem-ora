      "units": [
        {
          "key": "g-phrasal",
          "type": "pattern",
          "goal": "Verbos de dos piezas: GET UP, GIVE UP",
          "rule": "Verbo + partícula (up, off, out, on) = un verbo nuevo: get up = levantarse, give up = rendirse. Se aprenden como una sola pieza.",
          "pieces": [
            {
              "text": "give",
              "role": "fixed",
              "hint": "dar"
            },
            {
              "text": "up",
              "role": "slot",
              "hint": "(arriba) → rendirse"
            }
          ],
          "examples": [
            {
              "text": "I get up at seven.",
              "translation": "Me levanto a las siete.",
              "mirror": {
                "say": "Me levanto a las siete",
                "pieces": [
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "levanto",
                    "en": "get up",
                    "role": "verb",
                    "from": "me levanto",
                    "why": "Levantarse es un verbo de dos piezas: GET UP."
                  },
                  {
                    "es": "a las siete",
                    "en": "at seven",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "Don't give up!",
              "translation": "¡No te rindas!",
              "mirror": {
                "say": "¡No te rindas!",
                "pieces": [
                  {
                    "es": "No",
                    "en": "Don't",
                    "role": "helper"
