      "key": "47-acciones",
      "title": "Misión 47 · Acciones y sentidos",
      "units": [
        {
          "key": "g-senses",
          "type": "pattern",
          "goal": "Huele bien = IT SMELLS GOOD",
          "rule": "Con los sentidos, verbo + adjetivo (no adverbio): it smells good, tastes great, sounds nice, looks tired, feels soft.",
          "pieces": [
            {
              "text": "It",
              "role": "fixed",
              "hint": "ESO"
            },
            {
              "text": "smells",
              "role": "slot",
              "hint": "huele"
            },
            {
              "text": "good",
              "role": "fixed",
              "hint": "bien"
            }
          ],
          "examples": [
            {
              "text": "This soup smells good.",
              "translation": "Esta sopa huele bien.",
              "mirror": {
                "say": "Esta sopa huele bien",
                "pieces": [
                  {
                    "es": "Esta sopa",
                    "en": "This soup",
                    "role": "who"
                  },
                  {
                    "es": "huele",
                    "en": "smells",
                    "role": "verb"
                  },
                  {
                    "es": "bueno",
                    "en": "good",
                    "role": "word",
                    "from": "bien",
                    "why": "Con los sentidos va un adjetivo: smells GOOD (no well)."
                  }
                ]
              }
            },
            {
              "text": "You look tired.",
              "translation": "Pareces cansado.",
              "mirror": {
                "say": "Pareces cansado",
                "pieces": [
                  {
                    "es": "TÚ",
                    "en": "You",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "pareces",
                    "en": "look",
                    "role": "verb"
                  },
                  {
                    "es": "cansado",
                    "en": "tired",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "That sounds great!",
              "translation": "¡Suena genial!"
            },
            {
              "text": "It tastes like chicken.",
              "translation": "Sabe a pollo."
            }
          ],
          "pitfalls": [
            "«It smells well» está mal: con los sentidos, adjetivo (good).",
            "Saber A algo es TASTE LIKE: it tastes like chicken."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "NARIZ, BOCA y OJOS solo hablan con ADJETIVOS.",
            "emoji": "👃"
          }
        },
