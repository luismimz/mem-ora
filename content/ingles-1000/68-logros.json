    {
      "key": "68-logros",
      "title": "Misión 68 · Logros y experiencias (B1)",
      "units": [
        {
          "key": "g-present-perfect",
          "type": "pattern",
          "goal": "He estado / Estuve: HAVE BEEN o WAS",
          "rule": "Sin momento concreto (tu vida hasta hoy): have + participio. Con momento acabado (ayer, en 2020): pasado. I've been to Rome. I went in 2020.",
          "pieces": [
            {
              "text": "I've",
              "role": "fixed",
              "hint": "he"
            },
            {
              "text": "visited",
              "role": "slot",
              "hint": "visitado"
            }
          ],
          "examples": [
            {
              "text": "I've been to Rome twice.",
              "translation": "He estado en Roma dos veces.",
              "mirror": {
                "say": "He estado en Roma dos veces",
                "pieces": [
                  {
                    "es": "(YO) he",
                    "en": "I've",
                    "role": "helper",
                    "from": "He"
                  },
                  {
                    "es": "estado",
                    "en": "been",
                    "role": "verb"
                  },
                  {
                    "es": "a Roma",
                    "en": "to Rome",
                    "role": "word",
                    "from": "en Roma",
                    "why": "Haber estado EN un sitio es been TO."
                  },
                  {
                    "es": "dos veces",
                    "en": "twice",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "I went there in 2020.",
              "translation": "Fui en 2020.",
              "mirror": {
                "say": "Fui en 2020",
                "pieces": [
                  {
                    "es": "YO",
                    "en": "I",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "fui",
                    "en": "went",
                    "role": "verb",
                    "from": "fui",
                    "why": "Con un momento terminado (en 2020), pasado: went."
                  },
                  {
                    "es": "ALLÍ",
                    "en": "there",
                    "role": "word",
                    "ghost": true
                  },
                  {
                    "es": "en 2020",
                    "en": "in 2020",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "Have you finished yet?",
              "translation": "¿Has terminado ya?"
            },
            {
              "text": "She has lived here since 2019.",
              "translation": "Vive aquí desde 2019."
            }
          ],
          "pitfalls": [
            "«I have been in Rome yesterday» está mal: con yesterday, pasado (I was).",
            "Si dices cuándo, pasado; si no lo dices, have + participio."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "HAVE guarda recuerdos sin FECHA; el PASADO lleva FECHA.",
            "emoji": "🎒"
          }
        },
