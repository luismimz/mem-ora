  "modules": [
    {
      "key": "70-lo-que-dijo",
      "title": "Misión 70 · Lo que dijo (B1)",
      "units": [
        {
          "key": "g-reported",
          "type": "pattern",
          "goal": "Dijo que estaba cansado = he SAID he WAS tired",
          "rule": "Al contar lo que dijo alguien, el verbo da un paso atrás: «I am tired» → he said he was tired. Con tell, di a quién: she told me.",
          "pieces": [
            {
              "text": "He said",
              "role": "fixed",
              "hint": "dijo"
            },
            {
              "text": "he was tired",
              "role": "slot",
              "hint": "que estaba cansado"
            }
          ],
          "examples": [
            {
              "text": "He said he was tired.",
              "translation": "Dijo que estaba cansado.",
              "mirror": {
                "say": "Dijo que estaba cansado",
                "pieces": [
                  {
                    "es": "ÉL",
                    "en": "He",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "dijo",
                    "en": "said",
                    "role": "verb"
                  },
                  {
                    "es": "(ÉL) estaba",
                    "en": "he was",
                    "role": "helper",
                    "from": "que estaba",
                    "why": "El «que» se suele quitar: he said he was…"
                  },
                  {
                    "es": "cansado",
                    "en": "tired",
                    "role": "word"
                  }
                ]
              }
            },
            {
              "text": "She told me she would come.",
              "translation": "Me dijo que vendría.",
              "mirror": {
                "say": "Me dijo que vendría",
                "pieces": [
                  {
                    "es": "ELLA",
                    "en": "She",
                    "role": "who",
                    "ghost": true
                  },
                  {
                    "es": "me",
                    "en": "me",
                    "role": "word"
                  },
                  {
                    "es": "dijo",
                    "en": "told",
                    "role": "verb",
                    "from": "dijo",
                    "why": "Decir A alguien es TELL: she told me."
                  },
                  {
                    "es": "(ELLA) -RÍA",
                    "en": "she would",
                    "role": "helper",
                    "from": "que vendría"
                  },
                  {
                    "es": "venir",
                    "en": "come",
                    "role": "verb",
                    "from": "vendría"
                  }
                ],
                "order": [
                  0,
                  2,
                  1,
                  3,
                  4
                ]
              }
            },
            {
              "text": "They asked if I was ready.",
              "translation": "Me preguntaron si estaba listo."
            },
            {
              "text": "He told me not to worry.",
              "translation": "Me dijo que no me preocupara."
            }
          ],
          "pitfalls": [
            "«She said me» está mal: she TOLD me, o she SAID (sin me).",
            "«He said he is tired» se oye, pero lo normal es dar el paso atrás: he was."
          ],
          "association": {
            "technique": "absurd_scene",
            "scene": "SAID empuja cada VERBO un PASO hacia ATRÁS.",
            "emoji": "🗣️"
          }
        },
